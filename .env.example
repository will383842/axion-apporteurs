# Variables d'Axion Partners : les NOMS seulement, jamais une valeur (depot public, REQ-SEC-028).
# La liste vit dans src/lib/env.ts ; docs/env.md en est le rendu (pnpm env:doc), avec la regle et le
# role de chaque variable. tests/unit/securite/env-boot.spec.ts confronte ce fichier au schema, dans
# les deux sens. Aucune valeur par defaut : une variable requise absente fait refuser le demarrage.
#
# Secrets : au moins 32 octets tires au hasard, distincts les uns des autres, sans espace en bordure ;
# la cle de chiffrement : exactement 64 caracteres hexadecimaux.
SESSION_SECRET=
MAGIC_LINK_SECRET=
DEPOSIT_TOKEN_SECRET=
AXIONIA_WEBHOOK_SECRET=
AXIONIA_API_TOKEN=
DOCUSEAL_WEBHOOK_SECRET=
PII_ENCRYPTION_KEY=
IP_HASH_SALT=
PII_HASH_KEY=
PARTNERS_MCP_SHARED_SECRET=
ZEPTOMAIL_WEBHOOK_SECRET=
AXIONIA_RELECTURE_SECRET=
# SEC-63 : la cle de pseudonymisation des porteurs (apporteurRef), stable, hors rotation.
APPORTEUR_REF_KEY=
# Configuration (QA-T04). NOTIFY_SINK=true est exige hors production (REQ-CPL-021).
DATABASE_URL=
# QA-T62 : le role proprietaire, lu par l'entree de l'image seulement (migration, role d'execution).
DATABASE_MIGRATION_URL=
REDIS_URL=
NOTIFY_SINK=
PARTNERS_ENV=
LOG_LEVEL=
SENTRY_DSN=
PARTNERS_EMAIL_DMARC_VERIFIE=
PARTNERS_EMAIL_EXPEDITEUR=
AXIONIA_BASE_URL=
AXIONIA_API_ALLOWLIST=
ZEPTOMAIL_API_URL=

# Secrets conditionnels. ZEPTOMAIL_SEND_TOKEN (INT-T57) : exige si l envoi reel est allume.
# TELEGRAM_* (INT-T54) : jamais exiges au demarrage ; une alerte due sans canal fait echouer le passage.
ZEPTOMAIL_SEND_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
