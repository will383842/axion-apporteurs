# Secrets d'Axion Partners : les NOMS seulement, jamais une valeur (depot public, REQ-SEC-028).
# La liste vit dans src/lib/env.ts ; tests/unit/securite/env-boot.spec.ts confronte ce fichier au
# schema, dans les deux sens. Chaque valeur : au moins 32 octets tires au hasard, distincte de toutes
# les autres, sans espace en bordure ; la cle de chiffrement : exactement 64 caracteres hexadecimaux.
# Aucune valeur par defaut : une variable absente fait refuser le demarrage.
SESSION_SECRET=
MAGIC_LINK_SECRET=
DEPOSIT_TOKEN_SECRET=
AXIONIA_WEBHOOK_SECRET=
AXIONIA_API_TOKEN=
DOCUSEAL_WEBHOOK_SECRET=
PII_ENCRYPTION_KEY=
IP_HASH_SALT=
PII_HASH_KEY=
