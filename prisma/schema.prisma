// Schéma Prisma — Axion Partners. Socle posé par DM-01 (partners/ADR-0015).
//
// LES CONVENTIONS QUE CE FICHIER FIXE POUR TOUT LE DÉPÔT (docs/CONVENTIONS.md §1 à §3).
//   — Tables, colonnes ET enums en snake_case côté Postgres, par `@map` / `@@map` : le code ne
//     voit jamais le snake_case, la base ne voit jamais le camelCase.
//   — Identifiant d'agrégat : `String @id @default(uuid()) @db.Uuid`.
//   — Horodatage : `DateTime @db.Timestamptz(3)`, nom suffixé `At`, toujours en UTC.
//   — Montant : `Int`, en centimes HT signés, nom suffixé `Cents` ; jamais `Float` ni `Decimal`
//     (REQ-DM-001).
//   — Vocabulaire : un enum, jamais une `String` (REQ-DM-038, RM-04). Chaque valeur figure dans
//     `docs/GLOSSAIRE.md` : `pnpm partners:schema:enums` le vérifie dans les deux sens.
//   — Un enum n'entre ici qu'avec la colonne qui l'écrit : un vocabulaire que personne n'écrit
//     est déjà tenu par le glossaire, et n'a rien à faire dans la base.
//
// LE JOURNAL `Evenement` (REQ-DM-024, REQ-DM-041). Append-only et chaîné : `selfHash` =
// SHA-256(prevHash + forme canonique de l'enregistrement). Le refus de toute modification est
// celui de la BASE — déclencheurs posés en SQL brut par la première migration, que Prisma ne
// modélise pas. Aucune colonne hachée ne porte de `@default` : un défaut transformerait un oubli
// d'écriture en valeur silencieuse, sur une table qu'on ne peut plus corriger.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// POURQUOI UN VOCABULAIRE EST UN ENUM. Côté axionia, une colonne de statut en chaîne libre a laissé
// un seed écrire « valide » là où le code lisait « validee », et deux indicateurs Qualiopi sont
// passés au rouge pour ça. Le type attrape ce qu'aucune relecture ne voit. Les valeurs ne sont pas
// libres : ajouter une valeur ici sans l'ajouter au glossaire rougit ; l'y ajouter sans passer par
// le `gardien-spec` n'est pas permis (`docs/CONVENTIONS.md` §8).

/// Les treize états d'attribution (REQ-DM-006, `docs/GLOSSAIRE.md` §1). Sept d'entre eux occupent
/// le SIREN : la liste n'est PAS reprise ici, elle vit dans `src/domain/attribution/etats.ts`
/// (REQ-DM-003, RM-06), d'où la migration génère la clause `WHERE` de l'index partiel.
enum EtatAttribution {
  en_attente
  provisoire
  active
  rdv_pris
  proposition
  signee
  convertie
  figee_resiliation
  invalidee
  perdue
  perimee
  expiree
  annulee

  @@map("etat_attribution")
}

/// Les quatre rôles de la console (REQ-SEC-023, `docs/GLOSSAIRE.md` §7). L'identifiant est
/// `qualifieur` — `qualificateur` est un synonyme interdit, et le glossaire le dit.
enum ConsoleRole {
  admin
  qualifieur
  comptable
  lecteur

  @@map("console_role")
}

/// Un type = une charge fermée dans `src/domain/evenement/charges.ts` (REQ-DM-041). La genèse du
/// journal est l'événement de type `journal_ouvert` que la première migration écrit.
enum TypeEvenementJournal {
  journal_ouvert
  apporteur_statut_modifie
  attribution_contact_purge
  attribution_etat_modifie
  attribution_peremption_suspendue
  attribution_porteur_reaffecte
  piece_kyc_statut_modifie
  demande_confirmation_etat_modifie
  anomalie_statut_modifie
  contestation_modifiee
  rattachement_manuel_modifie
  anomalie_gel_modifie
  utilisateur_console_modifie
  journal_acces_gel_modifie
  apporteur_mis_en_demeure

  @@map("type_evenement_journal")
}

/// Les agrégats dont une transition s'écrit au journal — la liste de REQ-DM-024.
enum AgregatJournal {
  attribution
  apporteur
  ligne_commission
  releve
  piece_kyc
  contrat
  demande_confirmation
  anomalie
  utilisateur_console
  journal_acces_gel

  @@map("agregat_journal")
}

/// Le journal. Chaîne GLOBALE et linéaire : `prevHash` unique interdit la bifurcation et une
/// seconde genèse ; l'écrivain sérialise par un verrou consultatif (partners/ADR-0015, décision 3).
/// Toute colonne ajoutée plus tard est HORS hachage et le dit, ou exige un nouvel algorithme.
model Evenement {
  id        BigInt               @id @default(autoincrement())
  type      TypeEvenementJournal
  agregat   AgregatJournal?
  agregatId String?              @map("agregat_id") @db.Uuid
  survenuAt DateTime             @map("survenu_at") @db.Timestamptz(3)
  charge    Json
  prevHash  String               @unique @map("prev_hash") @db.Char(64)
  selfHash  String               @unique @map("self_hash") @db.Char(64)

  /// DM-55 : les notifications de l'espace que cet événement a produites.
  notificationsEspace NotificationEspace[]
  /// SEC-19 : la décision de contrat que cet événement fonde.
  decisionDeContrat   DecisionDeContrat?

  @@index([agregat, agregatId])
  @@map("evenements")
}

// ── DM-06 : l'apporteur ─────────────────────────────────────────────────────

/// Les neuf statuts STOCKÉS de l'apporteur (REQ-DM-011, `docs/GLOSSAIRE.md` §2). `actif` et
/// `dormant` sont dérivés par `src/domain/apporteur/activite.ts`, jamais stockés (REQ-CPL-027).
/// Les transitions permises vivent dans `src/domain/apporteur/matrice.ts`.
enum StatutApporteur {
  candidat
  retenu
  vivier
  refuse
  kyc_en_cours
  pret_a_signer
  signe
  suspendu
  resilie

  @@map("statut_apporteur")
}

/// Les motifs de résiliation (REQ-DM-011). Le vocabulaire de la faute en est retiré.
enum MotifResiliation {
  ordinaire_apporteur
  ordinaire_axion
  manquement_grave
  fin_de_plein_droit

  @@map("motif_resiliation")
}

/// Le type d'une pièce du KYC (REQ-DM-027, `docs/GLOSSAIRE.md` §4).
enum TypePieceKyc {
  siret
  tva
  rib
  identite
  vigilance
  rc_pro

  @@map("type_piece_kyc")
}

/// Le statut d'une pièce du KYC (REQ-DM-027, `docs/GLOSSAIRE.md` §4).
enum StatutPieceKyc {
  manquante
  a_verifier
  valide
  perimee
  refusee

  @@map("statut_piece_kyc")
}

/// Le droit qu'exerce le contact d'une attribution (REQ-JUR-065, `docs/GLOSSAIRE.md` §4).
enum DroitContact {
  acces
  rectification
  effacement
  limitation
  opposition

  @@map("droit_contact")
}

/// La donnée du contact que vise une rectification (REQ-JUR-065, `docs/GLOSSAIRE.md` §4).
enum DonneeContact {
  nom
  prenom
  fonction
  telephone
  email

  @@map("donnee_contact")
}

/// La suite donnée à une demande de droit (REQ-JUR-065, `docs/GLOSSAIRE.md` §4).
enum IssueDemandeDroit {
  appliquee
  refusee

  @@map("issue_demande_droit")
}

/// Le régime de TVA d'une identité de facturation (REQ-ARG-033, `docs/GLOSSAIRE.md` §4).
enum RegimeTva {
  assujetti
  franchise_293b

  @@map("regime_tva")
}

/// L'apporteur d'affaires (DM-06). Aucune coordonnée ici : nom, courriel et téléphone sont des
/// données chiffrées posées par la tâche du chiffrement ; l'IBAN vit dans la pièce `rib` du KYC
/// (HYP-DM06-IBAN), jamais dans cette table ni dans `identites_facturation`.
/// DM-50 : la qualité d'exercice de l'apporteur, liste FERMÉE d'A07 (2026-10-02). Les deux premières
/// rendent applicable la clause attributive de juridiction (art. 48 CPC) ; « micro-entrepreneur » est un
/// régime, pas une qualité.
enum QualiteExercice {
  commercant
  societe_commerciale
  artisan
  profession_liberale

  @@map("qualite_exercice")
}

/// DM-50 : une valeur par code NAF de REQ-JUR-022 (HYP-JUR-PROF-REGLEMENTEES) — 69.20Z, 66.19B, 66.22Z.
enum ProfessionReglementee {
  expertise_comptable
  auxiliaire_services_financiers
  intermediaire_assurance

  @@map("profession_reglementee")
}

model Apporteur {
  id                    String                 @id @default(uuid()) @db.Uuid
  statut                StatutApporteur
  /// Nul hors `resilie` ; exigé par la matrice pour y entrer.
  resiliationMotif      MotifResiliation?      @map("resiliation_motif")
  /// Public, lisible, non énumérable : `AX` + 6 caractères Crockford base32, 30 bits aléatoires
  /// (REQ-DM-012, HYP-DM06-CODE-PARRAINAGE). Forme tenue par un CHECK en SQL brut.
  codeParrainage        String                 @unique @map("code_parrainage") @db.Char(8)
  /// Exclu de tout agrégat d'argent, du lot, de la déclaration annuelle et de l'entonnoir
  /// (REQ-CPL-020). Sans défaut : l'écrivain DIT si l'apporteur est de test.
  isTest                Boolean                @map("is_test")
  /// DM-50 : déclarées au KYC ; nulles tant que l'apporteur ne les a pas déclarées.
  qualiteExercice       QualiteExercice?       @map("qualite_exercice")
  professionReglementee ProfessionReglementee? @map("profession_reglementee")

  /// Surcharge manuelle du seuil de vérification prioritaire (REQ-DM-010). NULLE = le défaut,
  /// DÉRIVÉ du palier par `seuilPrioritaire()` (HYP-D3) — aucun défaut littéral en base (RM-10).
  seuilVerificationPrioritaire   Int?      @map("seuil_verification_prioritaire")
  /// La trace de la surcharge : présente si et seulement si la surcharge l'est (CHECK en SQL brut).
  seuilVerificationPrioritaireAt DateTime? @map("seuil_verification_prioritaire_at") @db.Timestamptz(3)

  // Le snapshot de candidature, FIGÉ tel qu'axionia l'a émis (REQ-DM-035, REQ-QA-035).
  candidatureId      String  @unique @map("candidature_id") @db.Uuid
  reponsesJson       Json    @map("reponses_json")
  scoreInitial       Int     @map("score_initial")
  scorePartsJson     Json    @map("score_parts_json")
  scoreBaremeVersion String  @map("score_bareme_version")
  /// Chaîne transportée figée, jamais normalisée ; au-delà de la borne : nulle, jamais tronquée
  /// (HYP-DM06-SOURCE-CANAL). La borne égale `SOURCE_CANAL_LONGUEUR_MAX`.
  sourceCanal        String? @map("source_canal") @db.VarChar(512)
  parrainCodeCapture String? @map("parrain_code_capture")

  creeAt DateTime @map("cree_at") @db.Timestamptz(3)

  /// Le courriel de l'apporteur (SEC-03, REQ-SEC-024, partners/ADR-0013 décisions 11 à 13) : le bloc
  /// chiffré lié à la ligne, et l'empreinte de recherche HMAC sous PII_HASH_KEY. Jamais un clair.
  /// Les deux ensemble ou aucun (CHECK en SQL brut) ; nuls pour une ligne posée avant eux.
  emailChiffre Bytes?  @map("email_chiffre")
  emailHash    String? @unique @map("email_hash") @db.Char(64)

  /// Nom, prénom et téléphone (SEC-04, partners/ADR-0022) : blocs écrits par `colonnesPii`, empreinte
  /// du téléphone par `empreinteRecherche('telephone', …)`. Jamais un clair. Le bloc et l'empreinte
  /// du téléphone vont ensemble (CHECK en SQL brut) ; l'empreinte n'est PAS unique : deux personnes
  /// peuvent partager un numéro de standard. Aucune empreinte de nom ni de prénom.
  nomChiffre       Bytes?  @map("nom_chiffre")
  prenomChiffre    Bytes?  @map("prenom_chiffre")
  telephoneChiffre Bytes?  @map("telephone_chiffre")
  phoneHash        String? @map("phone_hash") @db.Char(64)

  /// Coupe d'un cran toutes les sessions du compte (REQ-SEC-003). Incrémentée PAR LA BASE à la
  /// résiliation et au changement de courriel, jamais à la suspension, jamais décrémentée
  /// (déclencheur `apporteurs_version_de_session`, SQL brut).
  sessionVersion Int @default(0) @map("session_version")

  /// L'acceptation de la politique de confidentialité (REQ-JUR-025) : la date et la version, ensemble
  /// ou aucune (CHECK en SQL brut).
  confidentialiteAccepteeAt DateTime? @map("confidentialite_acceptee_at") @db.Timestamptz(3)
  confidentialiteVersion    String?   @map("confidentialite_version") @db.VarChar(32)

  jetonsDepot             JetonDepot[]
  identitesFacturation    IdentiteFacturation[]
  liensMagiques           LienMagique[]
  sessionsEspace          SessionEspace[]
  courrielsEnvoyes        CourrielEnvoye[]
  changementsCourriel     ChangementCourriel[]
  attributions            Attribution[]
  depotsRefuses           DepotRefuse[]
  personnesDeclarees      PersonneDeclaree[]
  piecesKyc               PieceKyc[]
  notificationsEspace     NotificationEspace[]
  decisionsDeContrat      DecisionDeContrat[]
  preferencesNotification PreferenceNotification[]
  verifications           Verification[]
  alertesLiberation       AlerteLiberation[]
  anomalies               Anomalie[]
  contestations           Contestation[]
  appareilsConnus         AppareilConnu[]

  /// CPL-T06 (REQ-CPL-006) : les décisions sur la candidature, en ajout seul.
  decisionsCandidature DecisionCandidature[]

  @@index([phoneHash])
  @@map("apporteurs")
}

/// Un jeton de dépôt privé (REQ-DM-012). Seule l'EMPREINTE se stocke ; un jeton révoqué ne se
/// réactive pas (déclencheur `jetons_depot_revocation_definitive`, SQL brut). Un seul jeton ACTIF
/// par apporteur (REQ-SEC-005, SEC-11) : index unique partiel `jetons_depot_un_actif_par_apporteur`,
/// SQL brut. Aucune colonne d'expiration : l'échéance se dérive de `creeAt` et de la SSOT.
model JetonDepot {
  id             String    @id @default(uuid()) @db.Uuid
  apporteurId    String    @map("apporteur_id") @db.Uuid
  apporteur      Apporteur @relation(fields: [apporteurId], references: [id], onDelete: Restrict)
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  creeAt         DateTime  @map("cree_at") @db.Timestamptz(3)
  revoqueAt      DateTime? @map("revoque_at") @db.Timestamptz(3)
  dernierUsageAt DateTime? @map("dernier_usage_at") @db.Timestamptz(3)

  attributions Attribution[]

  @@index([apporteurId])
  @@map("jetons_depot")
}

/// Un lien magique de connexion (SEC-03, REQ-SEC-001). Seule l'EMPREINTE se stocke : HMAC-SHA-256
/// sous MAGIC_LINK_SECRET, domaine séparé, avec le `kid` de ce secret (partners/ADR-0013). Usage
/// unique : une ligne consommée ou annulée est gelée (déclencheur `liens_magiques_usage_unique`).
model LienMagique {
  id                   String              @id @default(uuid()) @db.Uuid
  /// La population du lien (SEC-17, partners/ADR-0022) : un apporteur OU un utilisateur de la
  /// console, jamais les deux, jamais aucun (CHECK `liens_magiques_une_population`, SQL brut).
  apporteurId          String?             @map("apporteur_id") @db.Uuid
  apporteur            Apporteur?          @relation(fields: [apporteurId], references: [id], onDelete: Restrict)
  utilisateurConsoleId String?             @map("utilisateur_console_id") @db.Uuid
  utilisateurConsole   UtilisateurConsole? @relation(fields: [utilisateurConsoleId], references: [id], onDelete: Restrict)
  tokenHash            String              @unique @map("token_hash") @db.Char(64)
  kid                  String              @db.Char(8)
  creeAt               DateTime            @map("cree_at") @db.Timestamptz(3)
  expireAt             DateTime            @map("expire_at") @db.Timestamptz(3)
  consommeAt           DateTime?           @map("consomme_at") @db.Timestamptz(3)
  annuleAt             DateTime?           @map("annule_at") @db.Timestamptz(3)
  /// Le code à six chiffres du courriel (REQ-UX-015) : HMAC-SHA-256 sous MAGIC_LINK_SECRET, domaine
  /// `partners.code.v1` (partners/ADR-0013, décision 14). Figé une fois posé.
  codeHash             String?             @map("code_hash") @db.Char(64)
  /// Essais de code, entre 0 et 5, jamais décrémentés (CHECK et déclencheur `liens_magiques_code_fige`).
  tentativesCode       Int                 @default(0) @map("tentatives_code")
  session              SessionEspace?

  @@index([apporteurId])
  @@index([utilisateurConsoleId])
  @@map("liens_magiques")
}

/// Une session de l'espace apporteur (SEC-03, REQ-SEC-001, REQ-SEC-003). Seule l'EMPREINTE du jeton
/// se stocke : HMAC-SHA-256 sous SESSION_SECRET, domaine séparé. Une session par lien au plus.
model SessionEspace {
  id                   String              @id @default(uuid()) @db.Uuid
  /// La population de la session (SEC-17), celle de son lien : un apporteur OU un utilisateur de
  /// la console (CHECK `sessions_espace_une_population`, SQL brut). L'espace refuse une session de
  /// la console ; `requireRole` refuse une session d'apporteur.
  apporteurId          String?             @map("apporteur_id") @db.Uuid
  apporteur            Apporteur?          @relation(fields: [apporteurId], references: [id], onDelete: Restrict)
  utilisateurConsoleId String?             @map("utilisateur_console_id") @db.Uuid
  utilisateurConsole   UtilisateurConsole? @relation(fields: [utilisateurConsoleId], references: [id], onDelete: Restrict)
  lienMagiqueId        String              @unique @map("lien_magique_id") @db.Uuid
  lienMagique          LienMagique         @relation(fields: [lienMagiqueId], references: [id], onDelete: Restrict)
  tokenHash            String              @unique @map("token_hash") @db.Char(64)
  kid                  String              @db.Char(8)
  ipHash               String?             @map("ip_hash") @db.Char(16)
  creeAt               DateTime            @map("cree_at") @db.Timestamptz(3)
  expireAt             DateTime            @map("expire_at") @db.Timestamptz(3)
  /// SEC-04 (REQ-SEC-003) : la révocation, définitive ; la dernière vue ; la version de l'apporteur
  /// COPIÉE par la base à l'ouverture (déclencheur `sessions_espace_version_copiee`), jamais réécrite.
  revoqueAt            DateTime?           @map("revoque_at") @db.Timestamptz(3)
  derniereVueAt        DateTime?           @map("derniere_vue_at") @db.Timestamptz(3)
  sessionVersion       Int                 @default(0) @map("session_version")

  @@index([apporteurId])
  @@index([utilisateurConsoleId])
  @@map("sessions_espace")
}

/// SEC-55 (REQ-SEC-003) : un appareil sur lequel un lien ou un code de connexion a été consommé,
/// par apporteur (la formule du registre de l'article 30).
/// Un signal de sécurité du COMPTE, jamais une anomalie : il n'est inscrit ni au dossier ni sur un
/// dépôt, et n'a AUCUNE vue dans l'espace. Seule l'EMPREINTE de l'appareil est gardée — un HMAC
/// tronqué à 128 bits, sous la clé dédiée des appareils (`kid`) —, jamais l'adresse réseau ni
/// l'identifiant en clair (CHECK `appareils_connus_empreinte_forme`, SQL brut). La dernière vue
/// avance à chaque reconnaissance ; la ligne est purgée une durée de session après elle
/// (`appareils_purger`). Migration `20261003002800_appareils_connus`.
model AppareilConnu {
  id            String    @id @default(uuid()) @db.Uuid
  apporteurId   String    @map("apporteur_id") @db.Uuid
  apporteur     Apporteur @relation(fields: [apporteurId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  empreinte     String    @db.Char(32)
  kid           String    @db.Char(8)
  confirmeAt    DateTime  @map("confirme_at") @db.Timestamptz(3)
  derniereVueAt DateTime  @map("derniere_vue_at") @db.Timestamptz(3)

  @@unique([apporteurId, empreinte, kid])
  @@index([derniereVueAt])
  @@map("appareils_connus")
}

// ── SEC-17 : les utilisateurs de la console ─────────────────────────────────

/// Un utilisateur de la console (SEC-17, REQ-SEC-023, partners/ADR-0022) : la cible de toutes les
/// colonnes auteur, traitePar et decidePar des phases 1 à 3. AUCUN mot de passe : il se connecte par
/// le même lien magique que l'apporteur (partners/ADR-0004 §1). Son RÔLE n'est jamais mis en
/// cookie : `requireRole` le relit à chaque requête, avec `desactiveAt`. Le courriel et le nom sont
/// des blocs écrits par `colonnesPii` ; l'empreinte du courriel est unique. L'adresse (bloc ET
/// empreinte, ensemble) ne peut manquer que sur un utilisateur désactivé (DM-44, CHECK
/// `utilisateurs_console_adresse_si_actif`).
model UtilisateurConsole {
  id                     String               @id @default(uuid()) @db.Uuid
  role                   ConsoleRole
  nomChiffre             Bytes?               @map("nom_chiffre")
  emailChiffre           Bytes?               @map("email_chiffre")
  emailHash              String?              @unique @map("email_hash") @db.Char(64)
  creeAt                 DateTime             @map("cree_at") @db.Timestamptz(3)
  /// Non nulle : l'utilisateur ne franchit plus la requête suivante, quelle que soit la date posée.
  desactiveAt            DateTime?            @map("desactive_at") @db.Timestamptz(3)
  /// SEC-30 (REQ-SEC-003) : incrémentée par la BASE à tout changement de rôle et à toute
  /// désactivation ; une session d'une version antérieure est refusée (`version_perimee`).
  sessionVersion         Int                  @default(0) @map("session_version")
  /// SEC-30 (REQ-DM-024) : l'invitation et l'activation ; l'échéance se dérive d'`inviteeAt` et de
  /// `DUREES_AUTH.invitationConsoleMs`, jamais d'une colonne.
  inviteeAt              DateTime?            @map("invitee_at") @db.Timestamptz(3)
  activeeAt              DateTime?            @default(dbgenerated("clock_timestamp()")) @map("activee_at") @db.Timestamptz(3)
  /// SEC-30 (quatre yeux, déclencheur `utilisateurs_console_quatre_yeux`) : un admin dont `valideAt`
  /// est nul est EN ATTENTE ; il n'a aucun droit d'administrateur.
  valideParId            String?              @map("valide_par_id") @db.Uuid
  validePar              UtilisateurConsole?  @relation("ValidationDesAdministrateurs", fields: [valideParId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  valideAt               DateTime?            @map("valide_at") @db.Timestamptz(3)
  administrateursValides UtilisateurConsole[] @relation("ValidationDesAdministrateurs")

  liensMagiques                LienMagique[]
  sessionsEspace               SessionEspace[]
  attributions                 Attribution[]            @relation("AttributionsDuConseiller")
  suspensionsDePeremption      Attribution[]            @relation("SuspensionsDePeremption")
  annulationsApresConfirmation Attribution[]            @relation("AnnulationsApresConfirmation")
  verifications                Verification[]
  anomaliesTraitees            Anomalie[]
  rattachementsDecides         RattachementManuel[]
  contestationsRepondues       Contestation[]
  qualificationsSaisies        Qualification[]
  accesJournalises             JournalAccesConsole[]
  /// SEC-61 : les gels du journal des accès qui visent l'utilisateur, ceux qu'il a posés, levés.
  gelsJournalVises             JournalAccesConsoleGel[] @relation("GelsJournalVises")
  gelsJournalPoses             JournalAccesConsoleGel[] @relation("GelsJournalPoses")
  gelsJournalLeves             JournalAccesConsoleGel[] @relation("GelsJournalLeves")
  sirensListeNoireAjoutes      SirenListeNoire[]
  /// CPL-T06 : les décisions de candidature dont l'utilisateur est l'auteur.
  decisionsCandidature         DecisionCandidature[]
  /// CPL-T24 : les RIB que l'utilisateur a vérifiés, et ceux qu'il a confirmés.
  ribsVerifies                 PieceKyc[]               @relation("RibsVerifies")
  ribsConfirmes                PieceKyc[]               @relation("RibsConfirmes")

  @@map("utilisateurs_console")
}

/// Un changement de courriel en cours ou clos (SEC-04, REQ-CPL-019, REQ-SEC-004). La NOUVELLE adresse,
/// chiffrée et empreinte (`colonnesPii`) ; le jeton de confirmation envoyé à l'ANCIENNE adresse en
/// empreinte HMAC sous MAGIC_LINK_SECRET, domaine `partners.changement-courriel.v1`, `kid` stocké.
/// Un seul changement en cours par apporteur (index unique partiel en SQL brut).
model ChangementCourriel {
  id           String    @id @default(uuid()) @db.Uuid
  apporteurId  String    @map("apporteur_id") @db.Uuid
  apporteur    Apporteur @relation(fields: [apporteurId], references: [id], onDelete: Restrict)
  emailChiffre Bytes     @map("email_chiffre")
  emailHash    String    @map("email_hash") @db.Char(64)
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  kid          String    @db.Char(8)
  demandeAt    DateTime  @map("demande_at") @db.Timestamptz(3)
  confirmeAt   DateTime? @map("confirme_at") @db.Timestamptz(3)
  annuleAt     DateTime? @map("annule_at") @db.Timestamptz(3)

  @@index([apporteurId])
  @@map("changements_courriel")
}

/// Une identité de facturation DATÉE, valable sur [debutAt, finAt) (REQ-CPL-005). Un relevé qui
/// en chevauche deux produit deux autofactures. AUCUNE colonne de RIB ni d'IBAN (HYP-DM06-IBAN).
model IdentiteFacturation {
  id           String       @id @default(uuid()) @db.Uuid
  apporteurId  String       @map("apporteur_id") @db.Uuid
  apporteur    Apporteur    @relation(fields: [apporteurId], references: [id], onDelete: Restrict)
  siren        String       @db.Char(9)
  regimeTva    RegimeTva    @map("regime_tva")
  debutAt      DateTime     @map("debut_at") @db.Timestamptz(3)
  finAt        DateTime?    @map("fin_at") @db.Timestamptz(3)
  /// DM-11 (HYP-DM06-IBAN) : la pièce `rib` de l'identité ; l'IBAN n'est QUE dans cette pièce.
  /// Clé étrangère composite (id, type, apporteur) : la base refuse une pièce d'un autre type, et
  /// celle d'un autre apporteur.
  /// La pièce RIB de l'identité de facturation (type contraint à 'rib').
  pieceKycId   String?      @map("piece_kyc_id") @db.Uuid
  pieceKycType TypePieceKyc @default(rib) @map("piece_kyc_type")
  pieceKyc     PieceKyc?    @relation(fields: [pieceKycId, pieceKycType, apporteurId], references: [id, type, apporteurId], onDelete: Restrict, onUpdate: Restrict, map: "identites_facturation_piece_rib_fkey")

  @@index([apporteurId])
  @@index([pieceKycId])
  @@map("identites_facturation")
}

/// Une pièce du KYC (DM-11, REQ-DM-027). Au plus une pièce COURANTE et au plus une EN
/// VÉRIFICATION par (apporteur, type) : deux index uniques partiels, en SQL brut. L'IBAN n'existe
/// QUE sur une pièce `rib`, chiffré (SEC-08) et empreint (CHECK). `expireAt` est obligatoire pour
/// `vigilance` et `rc_pro` (CHECK). Le fichier vit sur un stockage privé (REQ-SEC-026).
model PieceKyc {
  id               String              @id @default(uuid()) @db.Uuid
  apporteurId      String              @map("apporteur_id") @db.Uuid
  apporteur        Apporteur           @relation(fields: [apporteurId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type             TypePieceKyc
  statut           StatutPieceKyc
  verifieeAt       DateTime?           @map("verifiee_at") @db.Timestamptz(3)
  expireAt         DateTime?           @map("expire_at") @db.Timestamptz(3)
  /// La référence du fichier sur le stockage privé, jamais une URL publique.
  fichierRef       String?             @map("fichier_ref") @db.VarChar(300)
  /// La purge du fichier (la pièce d'identité, dès validation : REQ-JUR-029).
  fichierPurgeAt   DateTime?           @map("fichier_purge_at") @db.Timestamptz(3)
  remplaceeAt      DateTime?           @map("remplacee_at") @db.Timestamptz(3)
  ibanChiffre      Bytes?              @map("iban_chiffre")
  ibanHash         String?             @map("iban_hash") @db.Char(64)
  /// CPL-T24 (REQ-UX-027, REQ-DM-027) : le RIB à quatre yeux. Le premier regard VÉRIFIE hors bande,
  /// un AUTRE administrateur validé CONFIRME ; les quatre colonnes ne vivent que sur une pièce `rib`,
  /// s'écrivent une fois, et un RIB n'est `valide` que confirmé (CHECK et déclencheur
  /// `pieces_kyc_rib_quatre_yeux_garde`, SQL brut).
  ribVerifieParId  String?             @map("rib_verifie_par_id") @db.Uuid
  ribVerifiePar    UtilisateurConsole? @relation("RibsVerifies", fields: [ribVerifieParId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ribVerifieAt     DateTime?           @map("rib_verifie_at") @db.Timestamptz(3)
  ribConfirmeParId String?             @map("rib_confirme_par_id") @db.Uuid
  ribConfirmePar   UtilisateurConsole? @relation("RibsConfirmes", fields: [ribConfirmeParId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ribConfirmeAt    DateTime?           @map("rib_confirme_at") @db.Timestamptz(3)

  identitesFacturation IdentiteFacturation[]

  @@unique([id, type, apporteurId], map: "pieces_kyc_id_type_apporteur_key")
  @@index([apporteurId])
  @@index([ibanHash])
  @@map("pieces_kyc")
}

/// DM-59 (REQ-JUR-065) : une demande de droit du contact, tracée. `recueAt` est l'heure de la
/// BASE (déclencheur), et fait courir le délai d'un mois de l'art. 12.3. Aucune donnée en clair :
/// la nouvelle valeur d'une rectification est chiffrée, puis effacée à la clôture ou à l'échéance.
model DemandeDroitContact {
  id                String             @id @default(uuid()) @db.Uuid
  /// NULL une fois la trace anonymisée (DM-60, partners/ADR-0031), avec `traceAnonymiseeAt` (CHECK).
  attributionId     String?            @map("attribution_id") @db.Uuid
  attribution       Attribution?       @relation(fields: [attributionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  droit             DroitContact
  recueAt           DateTime           @default(dbgenerated("clock_timestamp()")) @map("recue_at") @db.Timestamptz(3)
  traiteeAt         DateTime?          @map("traitee_at") @db.Timestamptz(3)
  issue             IssueDemandeDroit?
  donneeVisee       DonneeContact?     @map("donnee_visee")
  valeurChiffree    Bytes?             @map("valeur_chiffree")
  valeurPurgeeAt    DateTime?          @map("valeur_purgee_at") @db.Timestamptz(3)
  prolongeeAt       DateTime?          @map("prolongee_at") @db.Timestamptz(3)
  /// DM-60 (REQ-JUR-065) : l'anonymisation de la trace, cinq ans après sa clôture
  /// (`DROITS_CONTACT_TRACE_ANS`), écrite une fois, liée au lien vidé (CHECK en SQL brut).
  traceAnonymiseeAt DateTime?          @map("trace_anonymisee_at") @db.Timestamptz(3)

  @@index([attributionId])
  @@map("demandes_droits_contact")
}

// ── SEC-06 : la réception des webhooks et le battement des tâches de fond (partners/ADR-0022) ──

/// La source d'un événement reçu (REQ-DM-036, `docs/GLOSSAIRE.md` §4).
enum SourceEvenementRecu {
  axionia
  docuseal

  @@map("source_evenement_recu")
}

/// Les types d'événements reçus : les douze de `TYPES_EVENEMENT` (`packages/contracts/events.ts`),
/// dans leur ordre, chacun sous son identifiant snake_case — le nom de fil dont le point devient un
/// souligné. La base porte le MÊME libellé : un nom de fil écrit ici en clair serait une recopie du
/// contrat que `gov:termes-interdits` refuse hors de `packages/contracts`. La correspondance est
/// DÉRIVÉE par `identifiantDuType` et confrontée à `pg_enum` par `tests/integration/webhook.spec.ts`.
/// Les quatre derniers sont entrés en `schema_version` 2, par ajout en fin d'enum (migration
/// `20260927000300_types_evenement_recu_v2`), le douzième en `schema_version` 3 (migration
/// `20261003000900_type_evenement_recu_devis_emis`) ; INT-T12 y ajoutera les types DocuSeal.
enum TypeEvenementRecu {
  client_cree
  client_mis_a_jour
  devis_signe
  facture_emise
  avoir_emis
  paiement_recu
  paiement_rembourse
  candidature_recue
  financement_mis_a_jour
  facture_annulee
  client_fusionne
  devis_emis

  @@map("type_evenement_recu")
}

/// Le statut d'un événement reçu. `held` : bien formé, de `schema_version` inconnue — inscrit et
/// alerté, jamais rejeté (REQ-ARG-003).
enum StatutEvenementRecu {
  recu
  traite
  en_attente_dependance
  held
  en_erreur

  @@map("statut_evenement_recu")
}

/// Réception des webhooks (REQ-DM-036, glossaire §5). Inscrite AVANT tout traitement ; le traitement
/// est hors requête (`src/server/queue/workers/evenement-recu.ts`). En ajout seul : seules les cinq
/// colonnes du traitement s'écrivent après l'inscription (déclencheur
/// `evenements_recus_reception_immuable`, SQL brut).
model EvenementRecu {
  id            String              @id @default(uuid()) @db.Uuid
  source        SourceEvenementRecu
  /// axionia : `event_id` de l'enveloppe (uuid v4). DocuSeal : clé dérivée (REQ-SEC-034).
  eventId       String              @map("event_id") @db.VarChar(200)
  eventType     TypeEvenementRecu   @map("event_type")
  schemaVersion Int                 @map("schema_version")
  /// Séquence d'émission axionia (REQ-INT-012) ; nulle pour DocuSeal.
  sequence      BigInt?
  /// La référence de sujet de l'enveloppe, mise à plat (`client:<id>`) : c'est elle qu'un enfant en
  /// attente cite comme dépendance.
  sujetRef      String?             @map("sujet_ref") @db.VarChar(180)
  /// Clé métier d'unicité : le `paymentId` des paiements ; nulle sinon (REQ-ARG-002).
  cleMetier     String?             @map("cle_metier") @db.VarChar(120)
  /// La référence du parent attendu, présente si et seulement si `en_attente_dependance`.
  dependanceRef String?             @map("dependance_ref") @db.VarChar(180)
  /// Le payload reçu, SANS donnée personnelle : la frontière de REQ-INT-029 est jugée à la porte.
  charge        Json
  /// SHA-256 du CORPS BRUT reçu, avant tout parse.
  payloadHash   String              @map("payload_hash") @db.Char(64)
  statut        StatutEvenementRecu
  receivedAt    DateTime            @map("received_at") @db.Timestamptz(3)
  survenuAt     DateTime            @map("survenu_at") @db.Timestamptz(3)
  processedAt   DateTime?           @map("processed_at") @db.Timestamptz(3)
  /// Nom de l'erreur de traitement ; jamais un extrait de la charge ni un message.
  error         String?             @db.VarChar(500)
  retryCount    Int                 @default(0) @map("retry_count")

  @@unique([source, eventId])
  @@index([statut, receivedAt])
  @@index([sujetRef])
  @@map("evenements_recus")
}

/// Battement des tâches de fond (REQ-QA-026). `tache` : clé de `src/server/taches/registre.ts`
/// (exception E1 de partners/ADR-0022, point 9), forme tenue par un CHECK.
model Battement {
  tache           String    @id @db.VarChar(64)
  dernierSuccesAt DateTime? @map("dernier_succes_at") @db.Timestamptz(3)
  dernierEchecAt  DateTime? @map("dernier_echec_at") @db.Timestamptz(3)
  /// Compteurs du dernier passage — identifiants et nombres seuls.
  compteurs       Json?

  @@map("battements")
}

// ── INT-T10 : l'émetteur de courriels et la liste de suppression (partners/ADR-0022) ──────────

/// Le statut d'une demande d'envoi (REQ-INT-022, REQ-INT-023). Un envoi RETENU est visible, jamais
/// jeté : il écrit sa ligne, et n'appelle pas le relais.
enum StatutCourriel {
  envoye
  retenu_adresse_supprimee
  retenu_dmarc_non_verifie
  echec

  @@map("statut_courriel")
}

/// Le motif d'une suppression. Une valeur de plainte n'entre ici que si le relais émet réellement
/// cet événement (INT-T10, acceptance 6).
enum MotifSuppressionCourriel {
  rebond_definitif

  @@map("motif_suppression_courriel")
}

/// Chaque demande d'envoi, qu'elle parte ou non (REQ-INT-022, REQ-INT-023, REQ-UX-016). Aucun corps,
/// aucune adresse : l'empreinte de recherche seule. DM-07 y a ajouté `attribution_id`.
model CourrielEnvoye {
  id                   String              @id @default(uuid()) @db.Uuid
  /// Exception E2 de partners/ADR-0022 (point 9) : clé de `src/server/notifications/table-ssot.ts`.
  gabarit              String              @db.VarChar(64)
  /// Empreinte de l'adresse de destination (`empreinteRecherche('courriel', …)`).
  emailHash            String              @map("email_hash") @db.Char(64)
  apporteurId          String?             @map("apporteur_id") @db.Uuid
  apporteur            Apporteur?          @relation(fields: [apporteurId], references: [id], onDelete: Restrict)
  statut               StatutCourriel
  demandeAt            DateTime            @map("demande_at") @db.Timestamptz(3)
  /// La date qui fait courir un délai (REQ-UX-016) — jamais une date de lecture.
  envoyeAt             DateTime?           @map("envoye_at") @db.Timestamptz(3)
  fournisseurMessageId String?             @map("fournisseur_message_id") @db.VarChar(200)
  /// Un code fermé, jamais la réponse du relais.
  erreur               String?             @db.VarChar(300)
  /// L'attribution dont le courriel parle (DM-07), nulle sinon.
  attributionId        String?             @map("attribution_id") @db.Uuid
  attribution          Attribution?        @relation(fields: [attributionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// DM-55 : la notification de l'espace que le courriel porte. Au plus un courriel non échoué par
  /// notification : index unique partiel `courriels_envoyes_un_par_notification`, en SQL brut. SET NULL :
  /// la purge de DM-61 supprime la notification, le courriel (preuve du délai) reste.
  notificationEspaceId String?             @map("notification_espace_id") @db.Uuid
  notificationEspace   NotificationEspace? @relation(fields: [notificationEspaceId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([emailHash])
  @@index([apporteurId, gabarit])
  @@index([statut, demandeAt])
  @@index([attributionId])
  @@map("courriels_envoyes")
}

/// UX-P1-10 (REQ-UX-016, REQ-JUR-039) — une notification de l'ESPACE de l'apporteur. `cle` est une clé
/// de la table des notifications (`src/server/notifications/table-ssot.ts`), exception E3 de
/// partners/ADR-0022 : la base en tient la FORME (CHECK), le code la VALEUR. `lueAt` n'est lu par
/// AUCUN calcul de délai : un délai court de `courriels_envoyes.envoye_at` (garde
/// `notifications-lue-at-inerte`).
model NotificationEspace {
  id                String             @id @default(uuid()) @db.Uuid
  apporteurId       String             @map("apporteur_id") @db.Uuid
  apporteur         Apporteur          @relation(fields: [apporteurId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cle               String             @db.VarChar(64)
  attributionId     String?            @map("attribution_id") @db.Uuid
  attribution       Attribution?       @relation(fields: [attributionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// L'heure d'inscription dans l'espace, PAS un horodatage opposable : aucun délai ne s'y appuie ;
  /// un délai court de `courriels_envoyes.envoye_at` (relecture A02, 2026-10-02).
  creeAt            DateTime           @default(now()) @map("cree_at") @db.Timestamptz(3)
  lueAt             DateTime?          @map("lue_at") @db.Timestamptz(3)
  /// DM-55 : l'événement du journal qui a produit la notification. L'idempotence tient au fait :
  /// index unique partiel `notifications_espace_une_par_evenement` (cle, evenement_id), et CHECK
  /// `notifications_espace_machine_a_son_evenement` (les deux clés de la machine ont leur événement),
  /// en SQL brut (partners/ADR-0015).
  evenementId       BigInt?            @map("evenement_id")
  /// Relation vers le journal chaîné, jamais employée par le code : on écrit `evenementId` (garde de l'écrivain unique).
  faitDuJournal     Evenement?         @relation(fields: [evenementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// DM-55 : l'anomalie confirmée qui fonde une `decision_attribution`, et elle seule (CHECK
  /// `notifications_espace_anomalie_decision_seule`, en SQL brut). Ses faits se lisent dans sa ligne au
  /// rendu ; ils n'entrent jamais dans le journal chaîné (décision (d) de la juriste pour DM-12).
  anomalieId        String?            @map("anomalie_id") @db.Uuid
  anomalie          Anomalie?          @relation(fields: [anomalieId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  /// SEC-19 : la décision de contrat (`mise_en_demeure`, `resiliation`) dont le passage rend le texte et
  /// les dates (CHECK `notifications_espace_decision_contrat_cle`, en SQL brut). SET NULL : rien ne
  /// bloque la purge de DM-61.
  decisionContratId String?            @map("decision_contrat_id") @db.Uuid
  decisionContrat   DecisionDeContrat? @relation(fields: [decisionContratId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  /// DM-55 : les courriels qui l'ont portée, une tentative par ligne.
  courriels         CourrielEnvoye[]

  @@index([apporteurId, creeAt])
  @@index([attributionId])
  @@index([decisionContratId])
  /// DM-61 : la purge à douze mois lit `cree_at` seul.
  @@index([creeAt])
  @@map("notifications_espace")
}

/// UX-P1-10 (REQ-UX-016) — la préférence d'un apporteur pour une clé de notification. Une clé OBLIGATOIRE
/// (`notificationObligatoire`) n'a pas de préférence désactivable : la table de code le refuse avant
/// l'écriture.
model PreferenceNotification {
  id          String    @id @default(uuid()) @db.Uuid
  apporteurId String    @map("apporteur_id") @db.Uuid
  apporteur   Apporteur @relation(fields: [apporteurId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cle         String    @db.VarChar(64)
  active      Boolean
  modifieeAt  DateTime  @map("modifiee_at") @db.Timestamptz(3)

  /// Une préférence par (apporteur, clé) ; sert aussi d'index à la clé étrangère. La clé primaire `id`
  /// fait passer la ligne par la couche cloisonnée sans exception (A02, 2026-10-02).
  @@unique([apporteurId, cle], map: "preferences_notification_apporteur_cle_unique")
  @@map("preferences_notification")
}

/// La liste de suppression (REQ-INT-023). Idempotente par construction : une adresse, une ligne.
model SuppressionCourriel {
  id        String                   @id @default(uuid()) @db.Uuid
  emailHash String                   @unique @map("email_hash") @db.Char(64)
  motif     MotifSuppressionCourriel
  survenuAt DateTime                 @map("survenu_at") @db.Timestamptz(3)
  creeAt    DateTime                 @map("cree_at") @db.Timestamptz(3)

  @@map("suppressions_courriel")
}

// ── DM-03-P : la grille de commission publiée par axionia ───────────────────────────────────────

/// Chaque version de la grille publiée par axionia (REQ-DM-014), importée telle quelle par
/// `src/server/grille/import.ts` : `contenuJson` est le contenu REÇU, `hash` l'empreinte
/// qu'axionia a calculée — rien n'est retapé ici (REQ-ARG-031, RM-01). Cible des clés étrangères
/// de DM-07 et DM-23, vers UNE version, jamais vers la grille « courante ». Immuable : la base
/// refuse UPDATE, DELETE et TRUNCATE (déclencheurs en SQL brut dans la migration).
model GrilleCommission {
  id          String   @id @default(uuid()) @db.Uuid
  /// Le N de `commissions.v<N>.json`.
  version     Int      @unique
  hash        String   @unique @db.Char(64)
  contenuJson Json     @map("contenu_json")
  publieeAt   DateTime @map("publiee_at") @db.Timestamptz(3)
  importeeAt  DateTime @map("importee_at") @db.Timestamptz(3)

  attributions Attribution[]

  @@map("grilles_commission")
}

// ── DM-07 : la persistance du dépôt (partners/ADR-0022, points 1, 2, 6, 11 et 12) ───────────────

/// Le canal d'un dépôt ou d'un refus (REQ-DM-012). `console` : la prise en charge d'un conseiller
/// salarié (W19), et lui seul — CHECK en SQL brut.
enum CanalDepot {
  espace
  lien_prive
  console

  @@map("canal_depot")
}

/// La projection de l'état administratif rendu par l'API publique, « A » et « C » (REQ-DM-030).
enum EtatAdministratif {
  actif
  cesse

  @@map("etat_administratif")
}

/// La catégorie d'entreprise rendue par l'API publique (REQ-DM-030).
enum CategorieEntreprise {
  pme
  eti
  ge

  @@map("categorie_entreprise")
}

/// Les sept motifs de refus d'un dépôt (REQ-SEC-022), exactement.
/// DM-71 (art. 3.3 du v2) : l'exception d'une annulation après la confirmation (forme d'A02, #806).
enum ExceptionAnnulation {
  erreur_identification
  fraude
  retablissement_apporteur

  @@map("exception_annulation")
}

enum MotifRefusDepot {
  anteriorite_client
  anteriorite_devis
  etablissement_cesse
  entreprise_hors_perimetre
  file_complete
  opposition_demarchage
  insincerite

  @@map("motif_refus_depot")
}

/// La qualité d'une personne déclarée (REQ-CPL-029) : les mots du contrat v1, art. 2.6 —
/// « associés, préposés ou sous-traitants ». Liste fermée, la plus petite confirmée (A07).
enum QualitePersonneDeclaree {
  associe
  prepose
  sous_traitant

  @@map("qualite_personne_declaree")
}

/// Une attribution : un dépôt d'apporteur, ou la prise en charge d'un conseiller salarié (W19).
/// Exactement un porteur (CHECK). L'unicité de l'occupant par SIREN est l'index PARTIEL généré
/// depuis `ETATS_OCCUPANTS` (REQ-DM-003), en SQL brut. Toutes les colonnes connues des phases 0 et
/// 1 sont posées ici, nulles si elles ne sont pas écrites à la naissance (partners/ADR-0022, point 2).
model Attribution {
  id                      String              @id @default(uuid()) @db.Uuid
  /// Le porteur : un apporteur OU un conseiller salarié, jamais les deux, jamais aucun (CHECK).
  apporteurId             String?             @map("apporteur_id") @db.Uuid
  apporteur               Apporteur?          @relation(fields: [apporteurId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Un utilisateur de rôle `conseiller_salarie` non désactivé (déclencheur en SQL brut).
  utilisateurConsoleId    String?             @map("utilisateur_console_id") @db.Uuid
  utilisateurConsole      UtilisateurConsole? @relation("AttributionsDuConseiller", fields: [utilisateurConsoleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  statut                  EtatAttribution
  /// 1 ou 2, présent si et seulement si `en_attente` ; réservé à l'apporteur (CHECK).
  rangAttente             Int?                @map("rang_attente") @db.SmallInt
  siren                   String              @db.Char(9)
  siret                   String?             @db.Char(14)
  /// UNE version de grille (REQ-DM-014) : présente si et seulement si le porteur est un apporteur.
  grilleCommissionId      String?             @map("grille_commission_id") @db.Uuid
  grilleCommission        GrilleCommission?   @relation(fields: [grilleCommissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  canal                   CanalDepot
  jetonDepotId            String?             @map("jeton_depot_id") @db.Uuid
  jetonDepot              JetonDepot?         @relation(fields: [jetonDepotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// L'horloge de la BASE, lue sous le verrou par SIREN (REQ-DM-005, HYP-A02-PRECISION-DEPOT) : le
  /// déclencheur `attributions_horloge_du_depot` ÉCRASE toute valeur fournie par
  /// `clock_timestamp()`. Le défaut ne sert qu'au typage. Seule colonne en précision 6
  /// (partners/ADR-0022, point 11).
  deposeeAt               DateTime            @default(dbgenerated("clock_timestamp()")) @map("deposee_at") @db.Timestamptz(6)
  /// L'heure de l'appareil à la saisie, informative, jamais opposable.
  clientCapturedAt        DateTime?           @map("client_captured_at") @db.Timestamptz(3)
  /// La date calendaire du contact (REQ-JUR-040).
  dateContact             DateTime            @map("date_contact") @db.Date
  /// La version de l'information des tiers acceptée au dépôt (REQ-JUR-008).
  informationTiersVersion String?             @map("information_tiers_version") @db.VarChar(32)
  verificationPrioritaire Boolean             @map("verification_prioritaire")
  /// Empreinte tronquée de l'adresse réseau ; empreinte de l'en-tête de navigateur (type `agent`).
  ipHash                  String?             @map("ip_hash") @db.Char(16)
  agentHash               String?             @map("agent_hash") @db.Char(64)

  // L'entreprise telle que rendue par l'API publique (REQ-DM-030, REQ-INT-021).
  raisonSociale       String?              @map("raison_sociale") @db.VarChar(300)
  natureJuridique     String?              @map("nature_juridique") @db.VarChar(4)
  /// Nul en repli (DM-28).
  codeNaf             String?              @map("code_naf") @db.VarChar(6)
  trancheEffectif     String?              @map("tranche_effectif") @db.VarChar(2)
  etatAdministratif   EtatAdministratif?   @map("etat_administratif")
  categorieEntreprise CategorieEntreprise? @map("categorie_entreprise")
  codePostalChiffre   Bytes?               @map("code_postal_chiffre")
  communeSiege        String?              @map("commune_siege") @db.VarChar(100)
  departement         String?              @db.VarChar(3)
  region              String?              @db.VarChar(3)
  /// Micro-degrés (EXT-T08) : jamais un flottant. Présentes ensemble (CHECK).
  latitudeMicrodeg    Int?                 @map("latitude_microdeg")
  longitudeMicrodeg   Int?                 @map("longitude_microdeg")
  /// Empreinte (`nom_personne`) et qualité des dirigeants, jamais un nom.
  dirigeantsJson      Json?                @map("dirigeants_json")
  entrepriseAVerifier Boolean              @map("entreprise_a_verifier")

  // Le contact rencontré (REQ-DM-031) : blocs écrits par `colonnesPii`, purgés ensemble.
  nomContactChiffre           Bytes?            @map("nom_contact_chiffre")
  prenomContactChiffre        Bytes?            @map("prenom_contact_chiffre")
  emailChiffre                Bytes?            @map("email_chiffre")
  emailHash                   String?           @map("email_hash") @db.Char(64)
  telephoneChiffre            Bytes?            @map("telephone_chiffre")
  phoneHash                   String?           @map("phone_hash") @db.Char(64)
  /// Chiffrée (décision A02 du 2026-10-02) : la borne de 120 caractères porte sur le clair.
  fonctionContactChiffre      Bytes?            @map("fonction_contact_chiffre")
  contexteChiffre             Bytes?            @map("contexte_chiffre")
  /// La personne déclarée qui a rencontré le contact (UX-P1-15).
  personneDeclareeId          String?           @map("personne_declaree_id") @db.Uuid
  personneDeclaree            PersonneDeclaree? @relation(fields: [personneDeclareeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// REQ-UX-039 : la précision n'existe que si le lien est déclaré (CHECK).
  lienInteretDeclare          Boolean           @map("lien_interet_declare")
  lienInteretPrecisionChiffre Bytes?            @map("lien_interet_precision_chiffre")

  // Le temps de la machine (REQ-DM-004, REQ-DM-007, REQ-UX-022).
  aQualifierDepuisAt               DateTime?                  @map("a_qualifier_depuis_at") @db.Timestamptz(3)
  premierContactAt                 DateTime?                  @map("premier_contact_at") @db.Timestamptz(3)
  confirmeeAt                      DateTime?                  @map("confirmee_at") @db.Timestamptz(3)
  fenetreFinAt                     DateTime?                  @map("fenetre_fin_at") @db.Timestamptz(3)
  peremptionAt                     DateTime?                  @map("peremption_at") @db.Timestamptz(3)
  /// La suspension de péremption : les trois ensemble ou aucune (CHECK).
  peremptionSuspendueAt            DateTime?                  @map("peremption_suspendue_at") @db.Timestamptz(3)
  peremptionSuspendueParId         String?                    @map("peremption_suspendue_par_id") @db.Uuid
  peremptionSuspenduePar           UtilisateurConsole?        @relation("SuspensionsDePeremption", fields: [peremptionSuspendueParId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  peremptionSuspendueJustification String?                    @map("peremption_suspendue_justification") @db.Text
  /// UX-P1-61 (contrat v2, art. 3.4 al. 2) : le motif FERMÉ de la suspension de péremption, posé avec son
  /// instant et son auteur ; la justification libre n'est plus admise (CHECK de 005010).
  peremptionSuspendueMotif         MotifSuspensionPeremption? @map("peremption_suspendue_motif")
  fenetreRedeclarationFinAt        DateTime?                  @map("fenetre_redeclaration_fin_at") @db.Timestamptz(3)
  /// DM-71 (art. 3.3 du v2, migration 005020) : l'exception d'une annulation APRÈS la confirmation et
  /// son auteur humain, posés ensemble avec l'arrivée en `annulee`, immuables ensuite (garde
  /// `attributions_annulation_apres_confirmation`).
  annulationException              ExceptionAnnulation?       @map("annulation_exception")
  annulationParId                  String?                    @map("annulation_par_id") @db.Uuid
  annulationPar                    UtilisateurConsole?        @relation("AnnulationsApresConfirmation", fields: [annulationParId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purgeContactAt                   DateTime?                  @map("purge_contact_at") @db.Timestamptz(3)
  contactPurgeAt                   DateTime?                  @map("contact_purge_at") @db.Timestamptz(3)
  /// L'empreinte HMAC du jeton de la page des droits du contact, jamais le jeton (DM-59). Unique
  /// quand posée (index partiel en SQL), effacée par la purge du contact.
  jetonDroitsHash                  String?                    @map("jeton_droits_hash") @db.Char(64)
  /// Verrou optimiste de la fiche (REQ-CPL-024).
  versionQualification             Int                        @default(0) @map("version_qualification")

  courrielsEnvoyes      CourrielEnvoye[]
  demandeConfirmation   DemandeConfirmation?
  demandesDroitsContact DemandeDroitContact[]
  notificationsEspace   NotificationEspace[]
  anomalies             Anomalie[]
  rattachementsManuels  RattachementManuel[]
  contestations         Contestation[]
  qualifications        Qualification[]

  @@index([apporteurId])
  @@index([utilisateurConsoleId])
  @@index([grilleCommissionId])
  @@index([jetonDepotId])
  @@index([personneDeclareeId])
  @@index([peremptionSuspendueParId])
  @@index([emailHash])
  @@index([phoneHash])
  @@map("attributions")
}

/// Un dépôt refusé (REQ-DM-043) : de quoi contester, aucune coordonnée du contact. Ajout seul,
/// sans exception (gabarit `refuser_modification_sauf()`, SQL brut). Réservé aux apporteurs.
model DepotRefuse {
  id            String          @id @default(uuid()) @db.Uuid
  apporteurId   String          @map("apporteur_id") @db.Uuid
  apporteur     Apporteur       @relation(fields: [apporteurId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Effacé douze mois après le refus (DM-53, partners/ADR-0030) : la ligne reste, sans lui.
  siren         String?         @db.Char(9)
  motif         MotifRefusDepot
  canal         CanalDepot
  refuseAt      DateTime        @map("refuse_at") @db.Timestamptz(3)
  /// La date de la purge du SIREN, liée à lui (CHECK) ; écrite une fois (gabarit).
  sirenPurgeAt  DateTime?       @map("siren_purge_at") @db.Timestamptz(3)
  contestations Contestation[]

  @@index([apporteurId])
  @@index([siren])
  @@map("depots_refuses")
}

/// Une personne déclarée par l'apporteur (REQ-CPL-029). Ajout seul, sauf la purge du nom et du
/// prénom et l'écriture unique du retrait (gabarit, SQL brut). Réservé aux apporteurs.
model PersonneDeclaree {
  id            String                  @id @default(uuid()) @db.Uuid
  apporteurId   String                  @map("apporteur_id") @db.Uuid
  apporteur     Apporteur               @relation(fields: [apporteurId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  nomChiffre    Bytes?                  @map("nom_chiffre")
  prenomChiffre Bytes?                  @map("prenom_chiffre")
  qualite       QualitePersonneDeclaree
  declareeAt    DateTime                @map("declaree_at") @db.Timestamptz(3)
  retireeAt     DateTime?               @map("retiree_at") @db.Timestamptz(3)

  attributions Attribution[]

  @@index([apporteurId])
  @@map("personnes_declarees")
}

/// CPL-T06 (REQ-CPL-006) — le résultat d'une décision sur une candidature. Chaque valeur est un statut
/// d'apporteur, atteint par la transition de la matrice qui la porte (`TRANSITION_DU_RESULTAT`,
/// `src/domain/candidature/decision.ts`).
enum ResultatDecisionCandidature {
  retenu
  vivier
  refuse

  @@map("resultat_decision_candidature")
}

/// CPL-T06 (REQ-CPL-006 ; cadrage de l'architecte du 2026-09-26, partners/ADR-0022) — l'étape 3 du
/// cycle. EN AJOUT SEUL : une nouvelle décision est une nouvelle ligne ; mise à jour, suppression et
/// troncature sont refusées par la base (`refuser_modification_sauf`, migration
/// `20261003001200_decisions_candidature`). Le changement de statut de l'apporteur qui la suit entre
/// au journal sous `apporteur_statut_modifie`.
model DecisionCandidature {
  id                    String                      @id @default(uuid()) @db.Uuid
  /// La fiche de l'apporteur. Le lien SORT de la ligne quand la fiche est effacée à l'échéance :
  /// NULL avec `apporteurPurgeAt`, ensemble ou pas du tout (CHECK
  /// `decisions_candidature_apporteur_purge_liee`), et au plus tard avec le motif (CHECK
  /// `decisions_candidature_purge_ordre`) ; la clé RESTRICT ne retient plus alors la fiche.
  apporteurId           String?                     @map("apporteur_id") @db.Uuid
  apporteur             Apporteur?                  @relation(fields: [apporteurId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  apporteurPurgeAt      DateTime?                   @map("apporteur_purge_at") @db.Timestamptz(3)
  resultat              ResultatDecisionCandidature
  /// Le motif de la décision, CHIFFRÉ (`colonnesPii`, champ `justification`, lié au modèle
  /// `decisionCandidature`, à l'id et au champ) : il peut nommer une personne. Exigé à l'insertion,
  /// jamais vide (le domaine juge les blancs avant le chiffrement ; la base refuse un chiffré vide).
  /// Il se PURGE : passé à NULL avec `justificationPurgeeAt`, ensemble ou pas du tout (CHECK
  /// `decisions_candidature_justification_purge_liee`), et ne revient jamais.
  justificationChiffre  Bytes?                      @map("justification_chiffre")
  justificationPurgeeAt DateTime?                   @map("justification_purgee_at") @db.Timestamptz(3)
  /// Déclaratif et informatif (REQ-JUR-013) : aucune transition n'en dépend. Nul quand la présence
  /// n'est pas connue.
  webinaireSuivi        Boolean?                    @map("webinaire_suivi")
  auteurId              String                      @map("auteur_id") @db.Uuid
  auteur                UtilisateurConsole          @relation(fields: [auteurId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decideeAt             DateTime                    @map("decidee_at") @db.Timestamptz(3)

  @@index([apporteurId, decideeAt])
  @@map("decisions_candidature")
}

/// DM-40 (REQ-DM-060) : l'état d'une demande de confirmation par e-mail (`docs/GLOSSAIRE.md` §4).
enum EtatDemandeConfirmation {
  planifiee
  annulee
  envoyee
  retenue
  rebond
  repondue_oui
  repondue_non
  clic_non_retenu
  opposee
  expiree

  @@map("etat_demande_confirmation")
}

/// DM-40 (REQ-DM-060) : la demande de confirmation d'un dépôt, UNE par attribution. Une TRACE : son
/// identité est figée, elle ne se supprime pas ; seuls son état et ses dates changent. L'échéance
/// d'envoi se DÉRIVE de `deposeeAt` et de la SSOT : elle ne se stocke pas. Les jetons vivent dans ses
/// émissions.
model DemandeConfirmation {
  id            String                  @id @default(uuid()) @db.Uuid
  attributionId String                  @unique @map("attribution_id") @db.Uuid
  attribution   Attribution             @relation(fields: [attributionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  etat          EtatDemandeConfirmation @default(planifiee)
  creeeAt       DateTime                @default(dbgenerated("clock_timestamp()")) @map("creee_at") @db.Timestamptz(3)
  envoyeeAt     DateTime?               @map("envoyee_at") @db.Timestamptz(3)
  reponduAt     DateTime?               @map("repondu_at") @db.Timestamptz(3)

  emissions EmissionDemandeConfirmation[]
  revisions RevisionDemandeConfirmation[]

  @@map("demandes_confirmation")
}

/// DM-40 (REQ-DM-060, HYP-W20-LIEN, HYP-W20-REBOND) : un ENVOI de la demande, une ligne par envoi, en
/// AJOUT SEUL. Ses deux jetons n'existent qu'en EMPREINTE ; une seule émission est active par demande
/// (index unique partiel). Une correction après rebond crée une émission et révoque la précédente.
model EmissionDemandeConfirmation {
  id           String              @id @default(uuid()) @db.Uuid
  demandeId    String              @map("demande_id") @db.Uuid
  demande      DemandeConfirmation @relation(fields: [demandeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  emiseAt      DateTime            @default(dbgenerated("clock_timestamp()")) @map("emise_at") @db.Timestamptz(3)
  /// L'empreinte du jeton « Oui », jamais le jeton.
  jetonOuiHash String?             @map("jeton_oui_hash") @db.Char(64)
  /// L'empreinte du jeton « Non », jamais le jeton.
  jetonNonHash String?             @map("jeton_non_hash") @db.Char(64)
  revoqueeAt   DateTime?           @map("revoquee_at") @db.Timestamptz(3)
  /// L'empreinte TRONQUÉE et salée de l'adresse réseau du clic (REQ-SEC-024), jamais l'adresse.
  clicIpHash   String?             @map("clic_ip_hash") @db.Char(16)

  @@index([demandeId])
  @@map("emissions_demande_confirmation")
}

/// DM-40 (REQ-DM-060, HYP-W20-ANNULATION) : une correction du contact ou du contexte pendant le délai
/// avant envoi, en AJOUT SEUL. Elle garde l'ANCIENNE valeur, recopiée telle quelle depuis
/// l'attribution : chaque bloc reste lié à l'attribution (son AAD nomme l'attribution et le champ).
/// Purgée avec le contact.
model RevisionDemandeConfirmation {
  id                     String              @id @default(uuid()) @db.Uuid
  demandeId              String              @map("demande_id") @db.Uuid
  demande                DemandeConfirmation @relation(fields: [demandeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviseeAt              DateTime            @default(dbgenerated("clock_timestamp()")) @map("revisee_at") @db.Timestamptz(3)
  nomContactChiffre      Bytes?              @map("nom_contact_chiffre")
  prenomContactChiffre   Bytes?              @map("prenom_contact_chiffre")
  emailChiffre           Bytes?              @map("email_chiffre")
  emailHash              String?             @map("email_hash") @db.Char(64)
  telephoneChiffre       Bytes?              @map("telephone_chiffre")
  phoneHash              String?             @map("phone_hash") @db.Char(64)
  fonctionContactChiffre Bytes?              @map("fonction_contact_chiffre")
  contexteChiffre        Bytes?              @map("contexte_chiffre")
  purgeeAt               DateTime?           @map("purgee_at") @db.Timestamptz(3)

  @@index([demandeId])
  @@map("revisions_demande_confirmation")
}

// ── DM-12 : vérifications, alertes de libération, anomalies, rattachements manuels, contestations ──
// Forme d'A02 (2026-10-03). Les CHECK, les index partiels, les fonctions et les déclencheurs vivent
// en SQL brut dans la migration (partners/ADR-0015).

/// Le résultat d'une vérification d'entreprise (REQ-DM-032), journal serveur, jamais exposé tel quel.
enum ResultatVerification {
  libre
  suivie
  cliente
  liste_noire
  fermee

  @@map("resultat_verification")
}

/// Le type d'une anomalie (REQ-DM-033) : la DÉCLARATION seule, jamais le rythme (REQ-SEC-017,
/// arbitrage de la juriste du 2026-10-03).
enum TypeAnomalie {
  sincerite
  auto_parrainage

  @@map("type_anomalie")
}

/// Le statut d'une anomalie : elle ne quitte `ouverte` qu'une fois, sans retour.
enum StatutAnomalie {
  ouverte
  levee
  confirmee

  @@map("statut_anomalie")
}

/// Ce qui prouve le lien de contrôle d'un rattachement manuel (contrat art. 3.6) : une pièce publique
/// de l'entreprise, jamais un texte libre (restriction de la sécurité).
enum SourceLienControle {
  rne
  kbis
  statuts
  bodacc
  comptes_annuels

  @@map("source_lien_controle")
}

/// L'objet d'une contestation écrite (REQ-DM-043, REQ-DM-034).
enum ObjetContestation {
  refus_depot
  annulation_attribution
  demande_rattachement

  @@map("objet_contestation")
}

/// Une vérification d'entreprise, en ajout seul (REQ-DM-032, REQ-SEC-021). Un porteur et un seul :
/// l'apporteur ou le conseiller salarié (W19, CHECK et déclencheur). Le plafond de vérifications est
/// un COMPTE, jamais une colonne. Seule l'empreinte d'adresse réseau se purge, avec sa date.
model Verification {
  id                      String               @id @default(uuid()) @db.Uuid
  apporteurId             String?              @map("apporteur_id") @db.Uuid
  apporteur               Apporteur?           @relation(fields: [apporteurId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  utilisateurConsoleId    String?              @map("utilisateur_console_id") @db.Uuid
  utilisateurConsole      UtilisateurConsole?  @relation(fields: [utilisateurConsoleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  siren                   String               @db.Char(9)
  resultat                ResultatVerification
  ipHash                  String?              @map("ip_hash") @db.Char(16)
  empreinteReseauPurgeeAt DateTime?            @map("empreinte_reseau_purgee_at") @db.Timestamptz(3)
  /// La purge du porteur à l'échéance du registre, posée une fois.
  porteurPurgeAt          DateTime?            @map("porteur_purge_at") @db.Timestamptz(3)
  verifieeAt              DateTime             @default(now()) @map("verifiee_at") @db.Timestamptz(3)

  @@index([apporteurId])
  @@index([utilisateurConsoleId])
  @@index([siren])
  @@map("verifications")
}

/// Une alerte de libération d'une entreprise suivie (REQ-DM-032) : une seule en attente par
/// (apporteur, SIREN), index partiel ; l'envoi se pose une fois.
model AlerteLiberation {
  id               String     @id @default(uuid()) @db.Uuid
  apporteurId      String?    @map("apporteur_id") @db.Uuid
  apporteur        Apporteur? @relation(fields: [apporteurId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  siren            String     @db.Char(9)
  creeAt           DateTime   @default(now()) @map("cree_at") @db.Timestamptz(3)
  envoyeeAt        DateTime?  @map("envoyee_at") @db.Timestamptz(3)
  /// La purge de l'apporteur à l'échéance du registre, posée une fois.
  apporteurPurgeAt DateTime?  @map("apporteur_purge_at") @db.Timestamptz(3)

  @@index([apporteurId])
  @@map("alertes_liberation")
}

/// Une anomalie (REQ-DM-033). Le score n'existe que pour la sincérité ; la clôture pose statut,
/// date, auteur et justification ensemble, une fois, sans retour (fonction dédiée).
model Anomalie {
  id                    String               @id @default(uuid()) @db.Uuid
  type                  TypeAnomalie
  score                 Int?                 @db.SmallInt
  apporteurId           String?              @map("apporteur_id") @db.Uuid
  apporteur             Apporteur?           @relation(fields: [apporteurId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attributionId         String?              @map("attribution_id") @db.Uuid
  attribution           Attribution?         @relation(fields: [attributionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  statut                StatutAnomalie       @default(ouverte)
  ouverteAt             DateTime             @default(now()) @map("ouverte_at") @db.Timestamptz(3)
  traiteParId           String?              @map("traite_par_id") @db.Uuid
  traitePar             UtilisateurConsole?  @relation(fields: [traiteParId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  traiteAt              DateTime?            @map("traite_at") @db.Timestamptz(3)
  /// La justification, CHIFFRÉE (`CHAMPS_PII`) : elle porte un soupçon sur une personne. Posée à la
  /// clôture, vidée par la purge seule.
  justificationChiffre  Bytes?               @map("justification_chiffre")
  justificationPurgeeAt DateTime?            @map("justification_purgee_at") @db.Timestamptz(3)
  /// L'ANONYMISATION : tout ce qui désigne une personne est vidé ; restent l'id, le type, le statut
  /// et les mois d'ouverture et de traitement (forme d'A02).
  anonymiseeAt          DateTime?            @map("anonymisee_at") @db.Timestamptz(3)
  /// La fin réelle de la mesure fondée sur une anomalie confirmée, posée une fois, jamais avant
  /// `traiteAt` ; elle fait courir l'échéance de l'anonymisation.
  mesureTermineeAt      DateTime?            @map("mesure_terminee_at") @db.Timestamptz(3)
  /// Le gel pour litige : posé une fois avec sa référence (un numéro, jamais un nom), levé une fois.
  gelLitigeAt           DateTime?            @map("gel_litige_at") @db.Timestamptz(3)
  gelLitigeLeveAt       DateTime?            @map("gel_litige_leve_at") @db.Timestamptz(3)
  gelLitigeRef          String?              @map("gel_litige_ref") @db.VarChar(64)
  /// DM-55 : les notifications des décisions qu'elle fonde.
  notificationsEspace   NotificationEspace[]

  @@index([apporteurId])
  @@index([attributionId])
  @@index([traiteParId])
  @@map("anomalies")
}

/// Un rattachement manuel d'une commande à une attribution (REQ-DM-034) : justifié (vingt caractères
/// utiles au moins), lien de contrôle antérieur au dépôt (déclencheur), un seul actif par SIREN de
/// commande (index partiel) ; la révocation se pose une fois.
model RattachementManuel {
  id                     String             @id @default(uuid()) @db.Uuid
  attributionId          String             @map("attribution_id") @db.Uuid
  attribution            Attribution        @relation(fields: [attributionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sirenCommande          String             @map("siren_commande") @db.Char(9)
  /// La justification, CHIFFRÉE (`CHAMPS_PII`) : elle peut nommer une personne ; vidée par la purge.
  justificationChiffre   Bytes?             @map("justification_chiffre")
  justificationPurgeeAt  DateTime?          @map("justification_purgee_at") @db.Timestamptz(3)
  /// La date de la pièce qui établit le lien, au début de son jour à Paris ; au plus tard au dépôt.
  lienControleEtabliAt   DateTime           @map("lien_controle_etabli_at") @db.Timestamptz(3)
  lienControleSourceType SourceLienControle @map("lien_controle_source_type")
  /// La référence de la pièce : identifiant court, un chiffre au moins, ni phrase ni nom (CHECK).
  lienControleSourceRef  String             @map("lien_controle_source_ref") @db.VarChar(64)
  decideParId            String             @map("decide_par_id") @db.Uuid
  decidePar              UtilisateurConsole @relation(fields: [decideParId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decideAt               DateTime           @default(now()) @map("decide_at") @db.Timestamptz(3)
  revoqueAt              DateTime?          @map("revoque_at") @db.Timestamptz(3)

  @@index([attributionId])
  @@index([decideParId])
  @@map("rattachements_manuels")
}

/// Une contestation écrite (REQ-DM-043, et la DEMANDE de rattachement de REQ-DM-034). La cible suit
/// l'objet (CHECK) ; texte et réponse sont chiffrés (`CHAMPS_PII`) ; la réponse se pose ensemble et
/// une fois, la purge vide texte et réponse en posant sa date. L'échéance de réponse se DÉRIVE de `recueAt` et de la SSOT : aucune colonne.
model Contestation {
  id              String              @id @default(uuid()) @db.Uuid
  apporteurId     String              @map("apporteur_id") @db.Uuid
  apporteur       Apporteur           @relation(fields: [apporteurId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  objet           ObjetContestation
  depotRefuseId   String?             @map("depot_refuse_id") @db.Uuid
  depotRefuse     DepotRefuse?        @relation(fields: [depotRefuseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attributionId   String?             @map("attribution_id") @db.Uuid
  attribution     Attribution?        @relation(fields: [attributionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  texteChiffre    Bytes?              @map("texte_chiffre")
  recueAt         DateTime            @default(now()) @map("recue_at") @db.Timestamptz(3)
  reponseChiffre  Bytes?              @map("reponse_chiffre")
  repondueParId   String?             @map("repondue_par_id") @db.Uuid
  reponduePar     UtilisateurConsole? @relation(fields: [repondueParId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  repondueAt      DateTime?           @map("repondue_at") @db.Timestamptz(3)
  /// La purge du texte et de la réponse, tracée et posée une fois (fonction dédiée).
  purgeeAt        DateTime?           @map("purgee_at") @db.Timestamptz(3)
  /// Le gel pour litige : posé une fois avec sa référence (un numéro, jamais un nom), levé une fois.
  gelLitigeAt     DateTime?           @map("gel_litige_at") @db.Timestamptz(3)
  gelLitigeLeveAt DateTime?           @map("gel_litige_leve_at") @db.Timestamptz(3)
  gelLitigeRef    String?             @map("gel_litige_ref") @db.VarChar(64)

  @@index([apporteurId])
  @@index([depotRefuseId])
  @@index([attributionId])
  @@index([repondueParId])
  @@map("contestations")
}

/// DM-09 (REQ-DM-008, HYP-A02-VOCABULAIRE-QUALIFICATION) : le résultat d'un appel de qualification.
/// Seul `non_confirme` éteint l'attribution et ouvre l'article 3.7.
enum ResultatContact {
  confirme
  non_confirme
  injoignable
  ne_se_souvient_pas

  @@map("resultat_contact")
}

enum InteretContact {
  eleve
  moyen
  faible
  nul

  @@map("interet_contact")
}

enum ProchaineEtape {
  rdv
  rappeler
  proposition
  perdue
  aucune

  @@map("prochaine_etape")
}

enum MotifPerte {
  pas_de_besoin
  deja_equipe
  hors_cible
  injoignable_definitif
  autre

  @@map("motif_perte")
}

/// DM-09 (REQ-DM-008) : une Qualification, en AJOUT SEUL — une nouvelle ne modifie jamais la
/// précédente. La personne interrogée et les termes de sa réponse sont des données d'un tiers,
/// chiffrées, purgées avec le contact (REQ-DM-031) : seule la purge les remet à NULL, avec sa date
/// (`contactPurgeAt`, posée une fois). Le nombre d'« injoignable » est DÉRIVÉ, jamais stocké.
model Qualification {
  id                        String             @id @default(uuid()) @db.Uuid
  attributionId             String             @map("attribution_id") @db.Uuid
  attribution               Attribution        @relation(fields: [attributionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resultatContact           ResultatContact    @map("resultat_contact")
  interet                   InteretContact?
  prochaineEtape            ProchaineEtape     @map("prochaine_etape")
  motifPerte                MotifPerte?        @map("motif_perte")
  rdvAt                     DateTime?          @map("rdv_at") @db.Timestamptz(3)
  rappelerAt                DateTime?          @map("rappeler_at") @db.Timestamptz(3)
  personneInterrogeeChiffre Bytes?             @map("personne_interrogee_chiffre")
  termesReponseChiffre      Bytes?             @map("termes_reponse_chiffre")
  contactPurgeAt            DateTime?          @map("contact_purge_at") @db.Timestamptz(3)
  auteurId                  String             @map("auteur_id") @db.Uuid
  auteur                    UtilisateurConsole @relation(fields: [auteurId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creeAt                    DateTime           @default(dbgenerated("clock_timestamp()")) @map("cree_at") @db.Timestamptz(3)

  @@index([attributionId, creeAt])
  @@index([auteurId])
  @@map("qualifications")
}

/// La nature d'un accès journalisé à la console (SEC-58) : les valeurs du glossaire.
enum NatureAccesConsole {
  connexion
  lecture_coordonnees_apporteur
  lecture_coordonnees_contact
  lecture_journal_acces

  @@map("nature_acces_console")
}

/// Le journal des accès à la console (SEC-58), par identifiants SEULS : qui, quand, quelle fiche,
/// l'empreinte tronquée de l'adresse réseau ; aucun contenu. Ajout seul par le gabarit commun
/// (`refuser_modification_sauf`) : la purge, à l'échéance de la SSOT, vide l'utilisateur, la cible et
/// l'empreinte et pose `purgeAt`, une fois ; la ligne nue (nature, date) reste. `cibleId` est
/// polymorphe (un apporteur, l'attribution qui porte le contact, ou, pour une lecture du journal
/// (SEC-60), l'utilisateur de la console dont les traces sont lues), sans clé étrangère, pour les trois
/// cibles, cette dernière comprise : le code vérifie chacune avant d'écrire. Seule une connexion
/// RÉUSSIE s'inscrit.
model JournalAccesConsole {
  id                   String              @id @db.Uuid
  utilisateurConsoleId String?             @map("utilisateur_console_id") @db.Uuid
  utilisateurConsole   UtilisateurConsole? @relation(fields: [utilisateurConsoleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  nature               NatureAccesConsole
  cibleId              String?             @map("cible_id") @db.Uuid
  ipHash               String?             @map("ip_hash") @db.Char(16)
  survenuAt            DateTime            @default(dbgenerated("clock_timestamp()")) @map("survenu_at") @db.Timestamptz(3)
  purgeAt              DateTime?           @map("purge_at") @db.Timestamptz(3)

  @@index([survenuAt])
  @@index([utilisateurConsoleId, survenuAt], map: "journal_acces_console_utilisateur_survenu_idx")
  @@map("journal_acces_console")
}

/// Le motif d'un gel du journal des accès à la console (SEC-61) : les valeurs du glossaire.
enum MotifGelJournal {
  incident
  litige

  @@map("motif_gel_journal")
}

/// Un gel du journal des accès à la console (SEC-61, forme d'A02 accordée avec la sécurité). Il vise
/// UNE portée, un utilisateur de la console OU une cible (CHECK `journal_acces_console_gels_une_portee`),
/// et protège de la purge les lignes de cette portée survenues depuis `depuis`, futures comprises si
/// `jusquA` est nul, tant qu'il est OUVERT ; `jusquA` posé BORNE le gel, inclus, et ne se modifie pas. La référence
/// est opaque (CHECK `journal_acces_console_gels_reference_forme`). Personne ne gèle ses propres traces
/// (CHECK `journal_acces_console_gels_pas_sur_soi`) ; la levée est faite par un autre que l'auteur et
/// que la personne visée (CHECK `journal_acces_console_gels_levee_quatre_yeux`). Garde dédiée en SQL
/// brut (`journal_acces_console_gels_garde`) : un gel naît ouvert, seule la levée s'écrit, une fois ;
/// il ne s'efface que levé et ses lignes purgées ; TRUNCATE refusé. Filet de la base sur le journal
/// (`journal_acces_console_gel_respecte`). Deux index partiels sur les gels ouverts.
model JournalAccesConsoleGel {
  id                String              @id @db.Uuid
  motif             MotifGelJournal
  reference         String              @db.VarChar(40)
  utilisateurViseId String?             @map("utilisateur_vise_id") @db.Uuid
  utilisateurVise   UtilisateurConsole? @relation("GelsJournalVises", fields: [utilisateurViseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "journal_acces_console_gels_utilisateur_vise_fkey")
  cibleId           String?             @map("cible_id") @db.Uuid
  depuis            DateTime            @db.Timestamptz(3)
  jusquA            DateTime?           @map("jusqu_a") @db.Timestamptz(3)
  poseParId         String              @map("pose_par_id") @db.Uuid
  posePar           UtilisateurConsole  @relation("GelsJournalPoses", fields: [poseParId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  poseAt            DateTime            @default(dbgenerated("clock_timestamp()")) @map("pose_at") @db.Timestamptz(3)
  leveParId         String?             @map("leve_par_id") @db.Uuid
  levePar           UtilisateurConsole? @relation("GelsJournalLeves", fields: [leveParId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  leveAt            DateTime?           @map("leve_at") @db.Timestamptz(3)

  @@map("journal_acces_console_gels")
}

/// L'origine d'une entreprise connue de la Société (REQ-DM-029) : les valeurs du glossaire.
enum OrigineEntrepriseConnue {
  client
  devis
  financeur

  @@map("origine_entreprise_connue")
}

/// Le motif d'inscription d'un SIREN sur la liste tenue par la Société (REQ-DM-028).
enum MotifListeNoire {
  administration
  financeur_public
  financeur_paritaire
  organisme_de_formation_partenaire

  @@map("motif_liste_noire")
}

/// La liste tenue par la Société (DM-10-P, REQ-DM-028) : un SIREN d'organisme, jamais une personne.
model SirenListeNoire {
  siren       String             @id @db.Char(9)
  motif       MotifListeNoire
  ajouteParId String             @map("ajoute_par_id") @db.Uuid
  ajoutePar   UtilisateurConsole @relation(fields: [ajouteParId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ajouteAt    DateTime           @default(dbgenerated("clock_timestamp()")) @map("ajoute_at") @db.Timestamptz(3)

  @@map("sirens_liste_noire")
}

/// La projection locale de l'antériorité (DM-10-P, REQ-DM-029) : une ligne par SIREN et par origine,
/// alimentée par les seuls événements d'axionia et par la liste de la Société. Mutable : la trace
/// vit dans `evenements_recus`.
model EntrepriseConnue {
  siren            String                  @db.Char(9)
  origine          OrigineEntrepriseConnue
  connueDepuisAt   DateTime                @map("connue_depuis_at") @db.Timestamptz(3)
  /// Origine client : la date de la DERNIÈRE prestation facturée (dernière facture non annulée), d'où
  /// se compte l'effacement à vingt-quatre mois. Origine devis : la dernière émission ou signature.
  dernierContactAt DateTime                @map("dernier_contact_at") @db.Timestamptz(3)

  @@id([siren, origine])
  @@map("entreprises_connues")
}

/// Un devis d'axionia, projeté pour juger « entièrement facturé » devis par devis (art. 3.3, écart B-11) :
/// le facturé HT, avoirs déduits, comparé au montant HT. Aucune donnée de personne.
model DevisConnu {
  devisRef            String    @id @map("devis_ref") @db.VarChar(64)
  siren               String    @db.Char(9)
  emisAt              DateTime  @map("emis_at") @db.Timestamptz(3)
  signeAt             DateTime? @map("signe_at") @db.Timestamptz(3)
  montantTotalHtCents Int       @map("montant_total_ht_cents")
  factureHtCents      Int       @default(0) @map("facture_ht_cents")
  majAt               DateTime  @default(dbgenerated("clock_timestamp()")) @map("maj_at") @db.Timestamptz(3)

  @@index([siren])
  @@map("devis_connus")
}

// ── SEC-19 : les décisions de contrat (forme d'A02, #703) ───────────────────

/// Le geste d'une décision de contrat (art. 11 et 12).
enum GesteDecisionContrat {
  mise_en_demeure
  resiliation

  @@map("geste_decision_contrat")
}

/// SEC-19 (REQ-JUR-006) : le texte d'une mise en demeure (`{faits}`) ou d'une résiliation motivée
/// (`{motif}`), CHIFFRÉ, et ses dates ; jamais au journal chaîné. La ligne nue reste comme preuve du
/// fait daté : seul le texte est purgé (garde `decisions_de_contrat_garde` et CHECK en SQL brut).
model DecisionDeContrat {
  id                  String               @id @default(uuid()) @db.Uuid
  apporteurId         String               @map("apporteur_id") @db.Uuid
  apporteur           Apporteur            @relation(fields: [apporteurId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  geste               GesteDecisionContrat
  /// La liste FERMÉE de l'art. 11.2, pour la mise en demeure seule (CHECK).
  article             String?              @db.VarChar(4)
  texteChiffre        Bytes?               @map("texte_chiffre")
  /// Jours civils de Paris, pour la résiliation seule (CHECK).
  dateReception       DateTime?            @map("date_reception") @db.Date
  dateEffet           DateTime?            @map("date_effet") @db.Date
  /// L'événement qui fonde la décision. Relation jamais employée par le code : on écrit `evenementId`.
  evenementId         BigInt               @unique @map("evenement_id")
  faitDuJournal       Evenement            @relation(fields: [evenementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creeAt              DateTime             @default(dbgenerated("clock_timestamp()")) @map("cree_at") @db.Timestamptz(3)
  textePurgeAt        DateTime?            @map("texte_purge_at") @db.Timestamptz(3)
  /// La clé d'idempotence, tirée par le serveur au rendu du formulaire : UNIQUE, immuable, jamais
  /// purgée ; exigée pour une mise en demeure (CHECK).
  cleIdempotence      String?              @unique @map("cle_idempotence") @db.Uuid
  /// L'empreinte HMAC des faits (`empreinteRecherche('faits_mise_en_demeure', …)`) : elle vit et meurt
  /// avec le texte (CHECK et garde) ; jamais de clair pour comparer.
  faitsEmpreinte      String?              @map("faits_empreinte") @db.Char(64)
  notificationsEspace NotificationEspace[]

  @@index([apporteurId])
  @@map("decisions_de_contrat")
}

/// UX-P1-61 (contrat v2, art. 3.4 al. 2 ; juriste #319 6037008645) : pourquoi l'absence d'échange tient
/// à la Société, ce qui suspend la péremption à 90 jours. Liste FERMÉE, sans texte libre.
enum MotifSuspensionPeremption {
  rdv_annule_par_la_societe
  absence_de_reponse_de_la_societe
  devis_non_emis_par_la_societe

  @@map("motif_suspension_peremption")
}
