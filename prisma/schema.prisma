// Schéma Prisma — Axion Partners. Socle posé par DM-01 (partners/ADR-0015).
//
// LES CONVENTIONS QUE CE FICHIER FIXE POUR TOUT LE DÉPÔT (docs/CONVENTIONS.md §1 à §3).
//   — Tables, colonnes ET enums en snake_case côté Postgres, par `@map` / `@@map` : le code ne
//     voit jamais le snake_case, la base ne voit jamais le camelCase.
//   — Identifiant d'agrégat : `String @id @default(uuid()) @db.Uuid`.
//   — Horodatage : `DateTime @db.Timestamptz(3)`, nom suffixé `At`, toujours en UTC.
//   — Montant : `Int`, en centimes HT signés, nom suffixé `Cents` ; jamais `Float` ni `Decimal`
//     (REQ-DM-001).
//   — Vocabulaire : un enum, jamais une `String` (REQ-DM-038, RM-04). Chaque valeur figure dans
//     `docs/GLOSSAIRE.md` : `pnpm partners:schema:enums` le vérifie dans les deux sens.
//   — Un enum n'entre ici qu'avec la colonne qui l'écrit : un vocabulaire que personne n'écrit
//     est déjà tenu par le glossaire, et n'a rien à faire dans la base.
//
// LE JOURNAL `Evenement` (REQ-DM-024, REQ-DM-041). Append-only et chaîné : `selfHash` =
// SHA-256(prevHash + forme canonique de l'enregistrement). Le refus de toute modification est
// celui de la BASE — déclencheurs posés en SQL brut par la première migration, que Prisma ne
// modélise pas. Aucune colonne hachée ne porte de `@default` : un défaut transformerait un oubli
// d'écriture en valeur silencieuse, sur une table qu'on ne peut plus corriger.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// POURQUOI UN VOCABULAIRE EST UN ENUM. Côté axionia, une colonne de statut en chaîne libre a laissé
// un seed écrire « valide » là où le code lisait « validee », et deux indicateurs Qualiopi sont
// passés au rouge pour ça. Le type attrape ce qu'aucune relecture ne voit. Les valeurs ne sont pas
// libres : ajouter une valeur ici sans l'ajouter au glossaire rougit ; l'y ajouter sans passer par
// le `gardien-spec` n'est pas permis (`docs/CONVENTIONS.md` §8).

/// Les treize états d'attribution (REQ-DM-006, `docs/GLOSSAIRE.md` §1). Sept d'entre eux occupent
/// le SIREN : la liste n'est PAS reprise ici, elle vit dans `src/domain/attribution/etats.ts`
/// (REQ-DM-003, RM-06), d'où la migration génère la clause `WHERE` de l'index partiel.
enum EtatAttribution {
  en_attente
  provisoire
  active
  rdv_pris
  proposition
  signee
  convertie
  figee_resiliation
  invalidee
  perdue
  perimee
  expiree
  annulee

  @@map("etat_attribution")
}

/// Les quatre rôles de la console (REQ-SEC-023, `docs/GLOSSAIRE.md` §7). L'identifiant est
/// `qualifieur` — `qualificateur` est un synonyme interdit, et le glossaire le dit.
enum ConsoleRole {
  admin
  qualifieur
  comptable
  lecteur

  @@map("console_role")
}

/// Un type = une charge fermée dans `src/domain/evenement/charges.ts` (REQ-DM-041). La genèse du
/// journal est l'événement de type `journal_ouvert` que la première migration écrit.
enum TypeEvenementJournal {
  journal_ouvert

  @@map("type_evenement_journal")
}

/// Les agrégats dont une transition s'écrit au journal — la liste de REQ-DM-024.
enum AgregatJournal {
  attribution
  apporteur
  ligne_commission
  releve
  piece_kyc
  contrat

  @@map("agregat_journal")
}

/// Le journal. Chaîne GLOBALE et linéaire : `prevHash` unique interdit la bifurcation et une
/// seconde genèse ; l'écrivain sérialise par un verrou consultatif (partners/ADR-0015, décision 3).
/// Toute colonne ajoutée plus tard est HORS hachage et le dit, ou exige un nouvel algorithme.
model Evenement {
  id        BigInt               @id @default(autoincrement())
  type      TypeEvenementJournal
  agregat   AgregatJournal?
  agregatId String?              @map("agregat_id") @db.Uuid
  survenuAt DateTime             @map("survenu_at") @db.Timestamptz(3)
  charge    Json
  prevHash  String               @unique @map("prev_hash") @db.Char(64)
  selfHash  String               @unique @map("self_hash") @db.Char(64)

  @@map("evenements")
}

// ── DM-06 : l'apporteur ─────────────────────────────────────────────────────

/// Les neuf statuts STOCKÉS de l'apporteur (REQ-DM-011, `docs/GLOSSAIRE.md` §2). `actif` et
/// `dormant` sont dérivés par `src/domain/apporteur/activite.ts`, jamais stockés (REQ-CPL-027).
/// Les transitions permises vivent dans `src/domain/apporteur/matrice.ts`.
enum StatutApporteur {
  candidat
  retenu
  vivier
  refuse
  kyc_en_cours
  pret_a_signer
  signe
  suspendu
  resilie

  @@map("statut_apporteur")
}

/// Les motifs de résiliation (REQ-DM-011). Le vocabulaire de la faute en est retiré.
enum MotifResiliation {
  ordinaire_apporteur
  ordinaire_axion
  manquement_grave

  @@map("motif_resiliation")
}

/// Le régime de TVA d'une identité de facturation (REQ-ARG-033, `docs/GLOSSAIRE.md` §4).
enum RegimeTva {
  assujetti
  franchise_293b

  @@map("regime_tva")
}

/// L'apporteur d'affaires (DM-06). Aucune coordonnée ici : nom, courriel et téléphone sont des
/// données chiffrées posées par la tâche du chiffrement ; l'IBAN vit dans la pièce `rib` du KYC
/// (HYP-DM06-IBAN), jamais dans cette table ni dans `identites_facturation`.
model Apporteur {
  id               String            @id @default(uuid()) @db.Uuid
  statut           StatutApporteur
  /// Nul hors `resilie` ; exigé par la matrice pour y entrer.
  resiliationMotif MotifResiliation? @map("resiliation_motif")
  /// Public, lisible, non énumérable : `AX` + 6 caractères Crockford base32, 30 bits aléatoires
  /// (REQ-DM-012, HYP-DM06-CODE-PARRAINAGE). Forme tenue par un CHECK en SQL brut.
  codeParrainage   String            @unique @map("code_parrainage") @db.Char(8)
  /// Exclu de tout agrégat d'argent, du lot, de la déclaration annuelle et de l'entonnoir
  /// (REQ-CPL-020). Sans défaut : l'écrivain DIT si l'apporteur est de test.
  isTest           Boolean           @map("is_test")

  /// Surcharge manuelle du seuil de vérification prioritaire (REQ-DM-010). NULLE = le défaut,
  /// DÉRIVÉ du palier par `seuilPrioritaire()` (HYP-D3) — aucun défaut littéral en base (RM-10).
  seuilVerificationPrioritaire   Int?      @map("seuil_verification_prioritaire")
  /// La trace de la surcharge : présente si et seulement si la surcharge l'est (CHECK en SQL brut).
  seuilVerificationPrioritaireAt DateTime? @map("seuil_verification_prioritaire_at") @db.Timestamptz(3)

  // Le snapshot de candidature, FIGÉ tel qu'axionia l'a émis (REQ-DM-035, REQ-QA-035).
  candidatureId      String  @unique @map("candidature_id") @db.Uuid
  reponsesJson       Json    @map("reponses_json")
  scoreInitial       Int     @map("score_initial")
  scorePartsJson     Json    @map("score_parts_json")
  scoreBaremeVersion String  @map("score_bareme_version")
  /// Chaîne transportée figée, jamais normalisée ; au-delà de la borne : nulle, jamais tronquée
  /// (HYP-DM06-SOURCE-CANAL). La borne égale `SOURCE_CANAL_LONGUEUR_MAX`.
  sourceCanal        String? @map("source_canal") @db.VarChar(512)
  parrainCodeCapture String? @map("parrain_code_capture")

  creeAt DateTime @map("cree_at") @db.Timestamptz(3)

  /// Le courriel de l'apporteur (SEC-03, REQ-SEC-024, partners/ADR-0013 décisions 11 à 13) : le bloc
  /// chiffré lié à la ligne, et l'empreinte de recherche HMAC sous PII_HASH_KEY. Jamais un clair.
  /// Les deux ensemble ou aucun (CHECK en SQL brut) ; nuls pour une ligne posée avant eux.
  emailChiffre Bytes?  @map("email_chiffre")
  emailHash    String? @unique @map("email_hash") @db.Char(64)

  jetonsDepot          JetonDepot[]
  identitesFacturation IdentiteFacturation[]
  liensMagiques        LienMagique[]
  sessionsEspace       SessionEspace[]
  courrielsEnvoyes     CourrielEnvoye[]

  @@map("apporteurs")
}

/// Un jeton de dépôt privé (REQ-DM-012). Seule l'EMPREINTE se stocke ; un jeton révoqué ne se
/// réactive pas (déclencheur `jetons_depot_revocation_definitive`, SQL brut).
model JetonDepot {
  id             String    @id @default(uuid()) @db.Uuid
  apporteurId    String    @map("apporteur_id") @db.Uuid
  apporteur      Apporteur @relation(fields: [apporteurId], references: [id], onDelete: Restrict)
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  creeAt         DateTime  @map("cree_at") @db.Timestamptz(3)
  revoqueAt      DateTime? @map("revoque_at") @db.Timestamptz(3)
  dernierUsageAt DateTime? @map("dernier_usage_at") @db.Timestamptz(3)

  @@index([apporteurId])
  @@map("jetons_depot")
}

/// Un lien magique de connexion (SEC-03, REQ-SEC-001). Seule l'EMPREINTE se stocke : HMAC-SHA-256
/// sous MAGIC_LINK_SECRET, domaine séparé, avec le `kid` de ce secret (partners/ADR-0013). Usage
/// unique : une ligne consommée ou annulée est gelée (déclencheur `liens_magiques_usage_unique`).
model LienMagique {
  id          String         @id @default(uuid()) @db.Uuid
  apporteurId String         @map("apporteur_id") @db.Uuid
  apporteur   Apporteur      @relation(fields: [apporteurId], references: [id], onDelete: Restrict)
  tokenHash   String         @unique @map("token_hash") @db.Char(64)
  kid         String         @db.Char(8)
  creeAt      DateTime       @map("cree_at") @db.Timestamptz(3)
  expireAt    DateTime       @map("expire_at") @db.Timestamptz(3)
  consommeAt  DateTime?      @map("consomme_at") @db.Timestamptz(3)
  annuleAt    DateTime?      @map("annule_at") @db.Timestamptz(3)
  session     SessionEspace?

  @@index([apporteurId])
  @@map("liens_magiques")
}

/// Une session de l'espace apporteur (SEC-03, REQ-SEC-001, REQ-SEC-003). Seule l'EMPREINTE du jeton
/// se stocke : HMAC-SHA-256 sous SESSION_SECRET, domaine séparé. Une session par lien au plus.
model SessionEspace {
  id            String      @id @default(uuid()) @db.Uuid
  apporteurId   String      @map("apporteur_id") @db.Uuid
  apporteur     Apporteur   @relation(fields: [apporteurId], references: [id], onDelete: Restrict)
  lienMagiqueId String      @unique @map("lien_magique_id") @db.Uuid
  lienMagique   LienMagique @relation(fields: [lienMagiqueId], references: [id], onDelete: Restrict)
  tokenHash     String      @unique @map("token_hash") @db.Char(64)
  kid           String      @db.Char(8)
  ipHash        String?     @map("ip_hash") @db.Char(16)
  creeAt        DateTime    @map("cree_at") @db.Timestamptz(3)
  expireAt      DateTime    @map("expire_at") @db.Timestamptz(3)

  @@index([apporteurId])
  @@map("sessions_espace")
}

/// Une identité de facturation DATÉE, valable sur [debutAt, finAt) (REQ-CPL-005). Un relevé qui
/// en chevauche deux produit deux autofactures. AUCUNE colonne de RIB ni d'IBAN (HYP-DM06-IBAN).
model IdentiteFacturation {
  id          String    @id @default(uuid()) @db.Uuid
  apporteurId String    @map("apporteur_id") @db.Uuid
  apporteur   Apporteur @relation(fields: [apporteurId], references: [id], onDelete: Restrict)
  siren       String    @db.Char(9)
  regimeTva   RegimeTva @map("regime_tva")
  debutAt     DateTime  @map("debut_at") @db.Timestamptz(3)
  finAt       DateTime? @map("fin_at") @db.Timestamptz(3)

  @@index([apporteurId])
  @@map("identites_facturation")
}

// ── SEC-06 : la réception des webhooks et le battement des tâches de fond (partners/ADR-0022) ──

/// La source d'un événement reçu (REQ-DM-036, `docs/GLOSSAIRE.md` §4).
enum SourceEvenementRecu {
  axionia
  docuseal

  @@map("source_evenement_recu")
}

/// Les types d'événements reçus : les sept de `TYPES_EVENEMENT` (`packages/contracts/events.ts`),
/// chacun sous son identifiant snake_case — le nom de fil dont le point devient un souligné. La
/// base porte le MÊME libellé : un nom de fil écrit ici en clair serait une recopie du contrat que
/// `gov:termes-interdits` refuse hors de `packages/contracts`. La correspondance est DÉRIVÉE par
/// `identifiantDuType` et confrontée à `pg_enum` par `tests/integration/webhook.spec.ts`.
/// INT-T01c y ajoutera les quatre types entrants, INT-T12 les types DocuSeal.
enum TypeEvenementRecu {
  client_cree
  client_mis_a_jour
  devis_signe
  facture_emise
  avoir_emis
  paiement_recu
  paiement_rembourse

  @@map("type_evenement_recu")
}

/// Le statut d'un événement reçu. `held` : bien formé, de `schema_version` inconnue — inscrit et
/// alerté, jamais rejeté (REQ-ARG-003).
enum StatutEvenementRecu {
  recu
  traite
  en_attente_dependance
  held
  en_erreur

  @@map("statut_evenement_recu")
}

/// Réception des webhooks (REQ-DM-036, glossaire §5). Inscrite AVANT tout traitement ; le traitement
/// est hors requête (`src/server/queue/workers/evenement-recu.ts`). En ajout seul : seules les cinq
/// colonnes du traitement s'écrivent après l'inscription (déclencheur
/// `evenements_recus_reception_immuable`, SQL brut).
model EvenementRecu {
  id            String              @id @default(uuid()) @db.Uuid
  source        SourceEvenementRecu
  /// axionia : `event_id` de l'enveloppe (uuid v4). DocuSeal : clé dérivée (REQ-SEC-034).
  eventId       String              @map("event_id") @db.VarChar(200)
  eventType     TypeEvenementRecu   @map("event_type")
  schemaVersion Int                 @map("schema_version")
  /// Séquence d'émission axionia (REQ-INT-012) ; nulle pour DocuSeal.
  sequence      BigInt?
  /// La référence de sujet de l'enveloppe, mise à plat (`client:<id>`) : c'est elle qu'un enfant en
  /// attente cite comme dépendance.
  sujetRef      String?             @map("sujet_ref") @db.VarChar(180)
  /// Clé métier d'unicité : le `paymentId` des paiements ; nulle sinon (REQ-ARG-002).
  cleMetier     String?             @map("cle_metier") @db.VarChar(120)
  /// La référence du parent attendu, présente si et seulement si `en_attente_dependance`.
  dependanceRef String?             @map("dependance_ref") @db.VarChar(180)
  /// Le payload reçu, SANS donnée personnelle : la frontière de REQ-INT-029 est jugée à la porte.
  charge        Json
  /// SHA-256 du CORPS BRUT reçu, avant tout parse.
  payloadHash   String              @map("payload_hash") @db.Char(64)
  statut        StatutEvenementRecu
  receivedAt    DateTime            @map("received_at") @db.Timestamptz(3)
  survenuAt     DateTime            @map("survenu_at") @db.Timestamptz(3)
  processedAt   DateTime?           @map("processed_at") @db.Timestamptz(3)
  /// Nom de l'erreur de traitement ; jamais un extrait de la charge ni un message.
  error         String?             @db.VarChar(500)
  retryCount    Int                 @default(0) @map("retry_count")

  @@unique([source, eventId])
  @@index([statut, receivedAt])
  @@index([sujetRef])
  @@map("evenements_recus")
}

/// Battement des tâches de fond (REQ-QA-026). `tache` : clé de `src/server/taches/registre.ts`
/// (exception E1 de partners/ADR-0022, point 9), forme tenue par un CHECK.
model Battement {
  tache           String    @id @db.VarChar(64)
  dernierSuccesAt DateTime? @map("dernier_succes_at") @db.Timestamptz(3)
  dernierEchecAt  DateTime? @map("dernier_echec_at") @db.Timestamptz(3)
  /// Compteurs du dernier passage — identifiants et nombres seuls.
  compteurs       Json?

  @@map("battements")
}

// ── INT-T10 : l'émetteur de courriels et la liste de suppression (partners/ADR-0022) ──────────

/// Le statut d'une demande d'envoi (REQ-INT-022, REQ-INT-023). Un envoi RETENU est visible, jamais
/// jeté : il écrit sa ligne, et n'appelle pas le relais.
enum StatutCourriel {
  envoye
  retenu_adresse_supprimee
  retenu_dmarc_non_verifie
  echec

  @@map("statut_courriel")
}

/// Le motif d'une suppression. Une valeur de plainte n'entre ici que si le relais émet réellement
/// cet événement (INT-T10, acceptance 6).
enum MotifSuppressionCourriel {
  rebond_definitif

  @@map("motif_suppression_courriel")
}

/// Chaque demande d'envoi, qu'elle parte ou non (REQ-INT-022, REQ-INT-023, REQ-UX-016). Aucun corps,
/// aucune adresse : l'empreinte de recherche seule. DM-07 y ajoutera `attribution_id`.
model CourrielEnvoye {
  id                   String         @id @default(uuid()) @db.Uuid
  /// Exception E2 de partners/ADR-0022 (point 9) : clé de `src/server/notifications/table-ssot.ts`.
  gabarit              String         @db.VarChar(64)
  /// Empreinte de l'adresse de destination (`empreinteRecherche('courriel', …)`).
  emailHash            String         @map("email_hash") @db.Char(64)
  apporteurId          String?        @map("apporteur_id") @db.Uuid
  apporteur            Apporteur?     @relation(fields: [apporteurId], references: [id], onDelete: Restrict)
  statut               StatutCourriel
  demandeAt            DateTime       @map("demande_at") @db.Timestamptz(3)
  /// La date qui fait courir un délai (REQ-UX-016) — jamais une date de lecture.
  envoyeAt             DateTime?      @map("envoye_at") @db.Timestamptz(3)
  fournisseurMessageId String?        @map("fournisseur_message_id") @db.VarChar(200)
  /// Un code fermé, jamais la réponse du relais.
  erreur               String?        @db.VarChar(300)

  @@index([emailHash])
  @@index([apporteurId, gabarit])
  @@index([statut, demandeAt])
  @@map("courriels_envoyes")
}

/// La liste de suppression (REQ-INT-023). Idempotente par construction : une adresse, une ligne.
model SuppressionCourriel {
  id        String                   @id @default(uuid()) @db.Uuid
  emailHash String                   @unique @map("email_hash") @db.Char(64)
  motif     MotifSuppressionCourriel
  survenuAt DateTime                 @map("survenu_at") @db.Timestamptz(3)
  creeAt    DateTime                 @map("cree_at") @db.Timestamptz(3)

  @@map("suppressions_courriel")
}
